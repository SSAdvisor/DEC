# ==============================================================================
# Legacy Computing Systems — Cloud Identity, Billing & Provisioning Configuration
# Copy this file to `.env` in the repository root (or pass via `docker run -e`).
# When omitted, Zero-Dependency Local Standalone Mode is active automatically.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Clerk Identity & Stripe Billing ($10/mo Individual & $15/mo Bundle Plans)
#    Dashboard: https://dashboard.clerk.com -> API Keys & Webhooks
# ------------------------------------------------------------------------------
# Frontend Publishable Key (enables @clerk/clerk-js widget on GET /signup)
CLERK_PUBLISHABLE_KEY=

# Backend Secret Key (syncs dec_username, rsts_ppn, vms_uic to Clerk publicMetadata)
CLERK_SECRET_KEY=

# Webhook Signing Secret for POST /api/v1/webhooks/clerk (Svix / HMAC-SHA256)
# Subscribe to: user.created, user.deleted, subscription.created, subscription.updated,
#               subscription.canceled, invoice.paid, invoice.payment_failed
CLERK_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 2. WorkOS Enterprise SAML 2.0 SSO & SCIM Directory Sync ($199-$499/mo Site)
#    Dashboard: https://dashboard.workos.com -> API Keys, Redirects & Webhooks
#    Maps Enterprise Organizations to Project/UIC Group [300,*]
# ------------------------------------------------------------------------------
# WorkOS Secret API Key (sk_test_... or sk_live_...)
WORKOS_API_KEY=

# WorkOS Client ID (client_...) for /auth/workos/login -> /auth/workos/callback
WORKOS_CLIENT_ID=

# WorkOS Webhook Secret for POST /api/v1/webhooks/workos
# Subscribe to: dsync.user.created, dsync.user.updated, dsync.user.deleted
WORKOS_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 3. Legacy Computing Systems Internal API Signing Secret
#    Used to sign/verify X-LCS-Signature (HMAC-SHA256) on /api/v1/users
# ------------------------------------------------------------------------------
LCS_API_SECRET=lcs-dev-hmac-secret-key
LCS_REQUIRE_SIGNATURE=0
