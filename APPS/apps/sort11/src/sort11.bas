10 ! ================================================================
20 ! SORT-11 - DEC RMS FILE SORT & RE-INDEXING UTILITY
30 ! AUTHENTIC DIGITAL EQUIPMENT CORPORATION RMS-11 SORT FACILITY
40 ! REIMPLEMENTED IN BASIC-PLUS-2 FOR DEC-APPS
50 ! SUPPORTS SEQUENTIAL STREAM AND SQLITE-BACKED RMS INDEXED FILES
60 ! ================================================================
70 MAP (REC_BUF) STRING MAP_LINE$ = 255%
80 DIM REC$(1000%)
90 DIM SKEY$(1000%)
100 NUM_RECS% = 0%
110 IN_FILE$ = ""
115 OUT_FILE$ = ""
120 IN_ORG$ = "SEQ"
125 OUT_ORG$ = "SEQ"
130 KEY_POS% = 1%
135 KEY_LEN% = 10%
140 SORT_ORDER$ = "A"
145 KEY_TYPE$ = "C"
150 CMD$ = COMMAND$
160 IF CMD$ <> "" THEN GOSUB 300
170 IF IN_FILE$ = "" THEN GOSUB 400
180 IF IN_FILE$ = "" OR OUT_FILE$ = "" THEN GOTO 990
190 ! Auto-detect RMS organization from file extension
192 IF INSTR(1%, IN_FILE$, ".IDX") > 0% OR INSTR(1%, IN_FILE$, ".idx") > 0% THEN IN_ORG$ = "RMS"
194 IF INSTR(1%, OUT_FILE$, ".IDX") > 0% OR INSTR(1%, OUT_FILE$, ".idx") > 0% THEN OUT_ORG$ = "RMS"
200 ! --- READ INPUT FILE ---
205 IF IN_ORG$ = "RMS" THEN GOTO 550
210 ! Read Sequential File
215 ON ERROR GOTO 270
220 OPEN IN_FILE$ FOR INPUT AS FILE #1%
240 READ_SEQ_LOOP:
250 LINE INPUT #1%, LINE_BUF$
255 NUM_RECS% = NUM_RECS% + 1%
260 REC$(NUM_RECS%) = LINE_BUF$
265 GOTO 240
270 CLOSE #1%
275 IF ERR = 5% THEN GOTO 980
280 RESUME 600
300 ! --- PARSE COMMAND LINE ARGUMENTS ---
310 KEY_POS% = 1%
312 KEY_LEN% = 10%
314 SORT_ORDER$ = "A"
316 KEY_TYPE$ = "C"
318 IN_ORG$ = "SEQ"
320 OUT_ORG$ = "SEQ"
330 EQ_P% = INSTR(1%, CMD$, "=")
335 IF EQ_P% = 0% THEN GOTO 380
340 OUT_FILE$ = LEFT$(CMD$, EQ_P% - 1%)
345 REM_CMD$ = MID$(CMD$, EQ_P% + 1%, LEN(CMD$) - EQ_P%)
350 SW_P% = INSTR(1%, REM_CMD$, "/KEY")
352 IF SW_P% = 0% THEN SW_P% = INSTR(1%, REM_CMD$, "/RMS")
354 IF SW_P% = 0% THEN SW_P% = INSTR(1%, REM_CMD$, "/IDX")
356 IF SW_P% = 0% THEN SW_P% = INSTR(1%, REM_CMD$, "/POS")
358 IF SW_P% = 0% THEN SW_P% = INSTR(1%, REM_CMD$, "/FORMAT")
360 IF SW_P% > 0% THEN GOTO 363
361 IN_FILE$ = REM_CMD$
362 SW$ = ""
364 GOTO 370
363 IN_FILE$ = LEFT$(REM_CMD$, SW_P% - 1%)
365 SW$ = MID$(REM_CMD$, SW_P%, LEN(REM_CMD$) - SW_P% + 1%)
370 P_POS% = INSTR(1%, SW$, "POS:")
371 IF P_POS% > 0% THEN KEY_POS% = VAL(MID$(SW$, P_POS% + 4%, 4%))
372 P_SIZ% = INSTR(1%, SW$, "SIZ:")
373 IF P_SIZ% > 0% THEN KEY_LEN% = VAL(MID$(SW$, P_SIZ% + 4%, 4%))
374 IF INSTR(1%, SW$, "DESC") > 0% THEN SORT_ORDER$ = "D"
376 IF INSTR(1%, SW$, "NUM") > 0% THEN KEY_TYPE$ = "N"
378 IF INSTR(1%, SW$, "RMS") > 0% OR INSTR(1%, SW$, "IDX") > 0% THEN OUT_ORG$ = "RMS"
379 RETURN
380 ! Positional Syntax: IN OUT [POS] [SIZ] [ORDER] [TYPE]
382 SP1% = INSTR(1%, CMD$, " ")
384 IF SP1% = 0% THEN GOTO 399
386 IN_FILE$ = LEFT$(CMD$, SP1% - 1%)
388 REM1$ = MID$(CMD$, SP1% + 1%, LEN(CMD$) - SP1%)
390 SP2% = INSTR(1%, REM1$, " ")
391 IF SP2% = 0% THEN GOTO 393
392 OUT_FILE$ = LEFT$(REM1$, SP2% - 1%)
394 GOTO 396
393 OUT_FILE$ = REM1$
395 RETURN
396 REM2$ = MID$(REM1$, SP2% + 1%, LEN(REM1$) - SP2%)
398 IF INSTR(1%, REM2$, "RMS") > 0% OR INSTR(1%, REM2$, "IDX") > 0% THEN OUT_ORG$ = "RMS"
399 RETURN
400 ! --- INTERACTIVE PROMPTS ---
405 PRINT "SORT-11 V3.0 - DEC RMS Sort Utility"
410 PRINT
415 INPUT "Input file: "; IN_FILE$
420 IF IN_FILE$ = "" THEN GOTO 490
425 INPUT "Output file: "; OUT_FILE$
430 IF OUT_FILE$ = "" THEN GOTO 490
435 PRINT "Input format (1=Sequential, 2=RMS Indexed) [1]: ";
436 INPUT FMT_IN$
437 IF FMT_IN$ = "2" THEN IN_ORG$ = "RMS" ELSE IN_ORG$ = "SEQ"
440 PRINT "Output format (1=Sequential, 2=RMS Indexed) [1]: ";
442 INPUT FMT_OUT$
444 IF FMT_OUT$ = "2" THEN OUT_ORG$ = "RMS" ELSE OUT_ORG$ = "SEQ"
450 PRINT "Key start position [1]: ";
452 INPUT POS_STR$
454 IF POS_STR$ <> "" THEN KEY_POS% = VAL(POS_STR$) ELSE KEY_POS% = 1%
460 PRINT "Key length [10]: ";
462 INPUT SIZ_STR$
464 IF SIZ_STR$ <> "" THEN KEY_LEN% = VAL(SIZ_STR$) ELSE KEY_LEN% = 10%
470 PRINT "Sort order (A=Ascending, D=Descending) [A]: ";
472 INPUT ORD_STR$
474 IF ORD_STR$ = "D" OR ORD_STR$ = "d" THEN SORT_ORDER$ = "D" ELSE SORT_ORDER$ = "A"
480 PRINT "Key type (C=Character, N=Numeric) [C]: ";
482 INPUT TYP_STR$
484 IF TYP_STR$ = "N" OR TYP_STR$ = "n" THEN KEY_TYPE$ = "N" ELSE KEY_TYPE$ = "C"
490 RETURN
550 ! Read RMS Indexed File
552 ON ERROR GOTO 580
555 OPEN IN_FILE$ FOR INPUT AS FILE #1%, ORGANIZATION INDEXED FIXED, PRIMARY KEY MAP_LINE$, MAP REC_BUF
565 READ_RMS_LOOP:
570 GET #1%
572 NUM_RECS% = NUM_RECS% + 1%
574 REC$(NUM_RECS%) = MAP_LINE$
576 GOTO 565
580 CLOSE #1%
582 IF ERR = 5% THEN GOTO 980
585 RESUME 600
600 ! --- EXTRACT SORT KEYS ---
605 ON ERROR GOTO 0
610 IF NUM_RECS% = 0% THEN GOTO 900
620 I% = 1%
625 EXTRACT_LOOP:
630 IF I% > NUM_RECS% THEN GOTO 700
635 CUR_LEN% = LEN(REC$(I%))
640 IF KEY_POS% > CUR_LEN% THEN GOTO 663
645 AVAIL_LEN% = CUR_LEN% - KEY_POS% + 1%
650 IF KEY_LEN% < AVAIL_LEN% THEN USE_LEN% = KEY_LEN% ELSE USE_LEN% = AVAIL_LEN%
660 S$ = MID$(REC$(I%), KEY_POS%, USE_LEN%)
662 GOTO 665
663 S$ = ""
665 SKEY$(I%) = S$
670 I% = I% + 1%
675 GOTO 625
700 ! --- SORT RECORDS (SELECTION SORT) ---
710 I% = 1%
715 SORT_OUTER:
720 IF I% >= NUM_RECS% THEN GOTO 800
725 J% = I% + 1%
730 SORT_INNER:
735 IF J% > NUM_RECS% THEN GOTO 780
736 S1$ = SKEY$(I%)
737 S2$ = SKEY$(J%)
740 IF SORT_ORDER$ = "D" THEN GOTO 760
742 IF KEY_TYPE$ = "N" THEN GOTO 750
744 IF S1$ > S2$ THEN GOTO 770 ELSE GOTO 778
750 V1 = VAL(S1$)
751 V2 = VAL(S2$)
752 IF V1 > V2 THEN GOTO 770 ELSE GOTO 778
760 IF KEY_TYPE$ = "N" THEN GOTO 765
762 IF S1$ < S2$ THEN GOTO 770 ELSE GOTO 778
765 V1 = VAL(S1$)
766 V2 = VAL(S2$)
767 IF V1 < V2 THEN GOTO 770 ELSE GOTO 778
770 TK$ = SKEY$(I%)
771 TR$ = REC$(I%)
772 TJ$ = SKEY$(J%)
773 SKEY$(I%) = TJ$
774 TJ$ = REC$(J%)
775 REC$(I%) = TJ$
776 SKEY$(J%) = TK$
777 REC$(J%) = TR$
778 J% = J% + 1%
779 GOTO 730
780 I% = I% + 1%
785 GOTO 715
800 ! --- WRITE SORTED RECORDS ---
810 IF OUT_ORG$ = "RMS" THEN GOTO 850
820 ! Write Sequential File
825 OPEN OUT_FILE$ FOR OUTPUT AS FILE #2%
830 K% = 1%
835 WRITE_SEQ_LOOP:
840 IF K% > NUM_RECS% THEN GOTO 848
842 PRINT #2%, REC$(K%)
845 K% = K% + 1%
846 GOTO 835
848 CLOSE #2%
849 GOTO 900
850 ! Write RMS Indexed File
855 OPEN OUT_FILE$ FOR OUTPUT AS FILE #2%, ORGANIZATION INDEXED FIXED, PRIMARY KEY MAP_LINE$, MAP REC_BUF
860 K% = 1%
865 WRITE_RMS_LOOP:
870 IF K% > NUM_RECS% THEN GOTO 885
872 MAP_LINE$ = REC$(K%)
874 PUT #2%
876 K% = K% + 1%
878 GOTO 865
885 CLOSE #2%
890 GOTO 900
900 ! --- PRINT SORT-11 SUMMARY REPORT ---
905 PRINT "SORT-11 V3.0 - DEC RMS Sort Utility"
910 PRINT "================================================================"
915 PRINT "Input File:         "; IN_FILE$; " ("; IN_ORG$; ")"
920 PRINT "Output File:        "; OUT_FILE$; " ("; OUT_ORG$; ")"
925 PRINT "Records Processed:  "; NUM_RECS%
930 PRINT "Key Position:       "; KEY_POS%
935 PRINT "Key Length:         "; KEY_LEN%
940 PRINT "Sort Order:         "; SORT_ORDER$
945 PRINT "Key Type:           "; KEY_TYPE$
950 PRINT "Status:             SUCCESS"
955 PRINT "================================================================"
960 GOTO 999
980 PRINT "SORT-11: Input file not found: "; IN_FILE$
985 GOTO 999
990 PRINT "SORT-11: Invalid or missing file specifications."
999 END
