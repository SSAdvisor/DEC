10 ! ================================================================
20 ! RMSRST - DEC RMS-11 FILE RESTORE UTILITY
30 ! AUTHENTIC DIGITAL EQUIPMENT CORPORATION RMS-11 RESTORE FACILITY
40 ! REIMPLEMENTED IN BASIC-PLUS-2 FOR DEC-APPS
50 ! ================================================================
60 MAP (REC_BUF) STRING MAP_LINE$ = 255%
70 DIM REC$(1000%)
80 NUM_RECS% = 0%
90 EXP_RECS% = 0%
100 BCK_FILE$ = ""
110 OUT_FILE$ = ""
120 TARGET_ORG$ = "SEQUENTIAL"
130 IN_DATA% = 0%
140 CMD$ = COMMAND$
150 IF CMD$ <> "" THEN GOSUB 300
160 IF BCK_FILE$ = "" THEN GOSUB 400
170 IF BCK_FILE$ = "" OR OUT_FILE$ = "" THEN GOTO 990
180 ! Auto-detect target organization
190 IF INSTR(1%, OUT_FILE$, ".IDX") > 0% OR INSTR(1%, OUT_FILE$, ".idx") > 0% THEN TARGET_ORG$ = "INDEXED"
200 ! --- READ BACKUP CONTAINER ---
210 ON ERROR GOTO 290
220 OPEN BCK_FILE$ FOR INPUT AS FILE #1%
230 READ_BCK_LOOP:
240 LINE INPUT #1%, L$
245 IF INSTR(1%, L$, "ORG: INDEXED") > 0% THEN TARGET_ORG$ = "INDEXED"
250 IF INSTR(1%, L$, "RECORDS:") > 0% THEN
252   P% = INSTR(1%, L$, ":") + 1%
254   EXP_RECS% = VAL(MID$(L$, P%, LEN(L$) - P% + 1%))
256 END IF
260 IF L$ = "DATA_START" THEN
262   IN_DATA% = 1%
263   GOTO 230
264 END IF
265 IF L$ = "DATA_END" THEN
266   IN_DATA% = 0%
267   GOTO 230
268 END IF
270 IF IN_DATA% = 1% THEN
272   NUM_RECS% = NUM_RECS% + 1%
274   REC$(NUM_RECS%) = L$
276 END IF
280 GOTO 230
290 CLOSE #1%
295 RESUME 500
300 ! --- PARSE COMMAND LINE ---
310 EQ_P% = INSTR(1%, CMD$, "=")
315 IF EQ_P% = 0% THEN GOTO 380
320 OUT_FILE$ = LEFT$(CMD$, EQ_P% - 1%)
325 BCK_FILE$ = MID$(CMD$, EQ_P% + 1%, LEN(CMD$) - EQ_P%)
330 RETURN
380 ! Positional: BCK OUT
382 SP_P% = INSTR(1%, CMD$, " ")
384 IF SP_P% = 0% THEN GOTO 390
386 BCK_FILE$ = LEFT$(CMD$, SP_P% - 1%)
388 OUT_FILE$ = MID$(CMD$, SP_P% + 1%, LEN(CMD$) - SP_P%)
390 RETURN
400 ! --- INTERACTIVE PROMPTS ---
405 PRINT "RMSRST V2.0 - DEC RMS-11 File Restore Utility"
410 PRINT ""
415 INPUT "Backup container file (.BCK): "; BCK_FILE$
420 IF BCK_FILE$ = "" THEN GOTO 430
425 INPUT "Target restored RMS file: "; OUT_FILE$
430 RETURN
500 ! --- RECONSTRUCT RESTORED FILE ---
505 ON ERROR GOTO 980
510 IF TARGET_ORG$ = "INDEXED" THEN GOTO 560
520 ! Write Sequential File
525 OPEN OUT_FILE$ FOR OUTPUT AS FILE #2%
530 K% = 1%
535 WRITE_SEQ_LOOP:
540 IF K% > NUM_RECS% THEN GOTO 550
545 PRINT #2%, REC$(K%)
547 K% = K% + 1%
548 GOTO 535
550 CLOSE #2%
555 GOTO 600
560 ! Write RMS Indexed SQLite File
565 OPEN OUT_FILE$ FOR OUTPUT AS FILE #2%, ORGANIZATION INDEXED FIXED, PRIMARY KEY MAP_LINE$, MAP REC_BUF
570 K% = 1%
575 WRITE_RMS_LOOP:
580 IF K% > NUM_RECS% THEN GOTO 595
585 MAP_LINE$ = REC$(K%)
590 PUT #2%
592 K% = K% + 1%
593 GOTO 575
595 CLOSE #2%
600 ON ERROR GOTO 0
610 ! --- REPORT SUCCESS ---
615 PRINT "RMSRST V2.0 - DEC RMS-11 File Restore Utility"
620 PRINT "================================================================"
625 PRINT "Backup Container:   "; BCK_FILE$
630 PRINT "Restored Target:    "; OUT_FILE$
635 PRINT "Target Format:      "; TARGET_ORG$
640 PRINT "Records Expected:   "; EXP_RECS%
645 PRINT "Records Restored:   "; NUM_RECS%
650 IF NUM_RECS% = EXP_RECS% THEN PRINT "Integrity Check:    VERIFIED (OK)" ELSE PRINT "Integrity Check:    WARNING (COUNT MISMATCH)"
655 PRINT "Status:             SUCCESS"
660 PRINT "================================================================"
665 GOTO 999
980 PRINT "RMSRST: Error recreating restored file: "; OUT_FILE$
985 GOTO 999
990 PRINT "RMSRST: Missing backup or target file specification."
999 END
