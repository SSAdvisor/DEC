920 IF NUM_REC% = 0% THEN GOTO 3370
930 F_REG$ = ""
940 IF ARGS$ <> "" THEN U_IN$ = ARGS$
945 IF ARGS$ <> "" THEN GOSUB 580
950 IF ARGS$ <> "" THEN F_REG$ = U_OUT$
960 PRINT EQU$ \ PRINT "  FOCUS 4GL: TABLE FILE SALES SUM UNITS DOLLARS BY REGION BY PROD_CODE \ END" \ PRINT SEP$
970 PRINT "  PAGE 1      REGION    PROD_CODE      UNITS      DOLLARS($K)" \ PRINT SEP$
980 TI% = 1% \ T_CNT% = 0% \ T_UNI% = 0% \ T_DOL% = 0%
990 IF TI% > NUM_REC% THEN GOTO 1090
1000 T_IN$ = S_REG$(TI%) \ GOSUB 500 \ R_CLEAN$ = T_OUT$
1010 IF F_REG$ = "" THEN GOTO 1040
1020 IF R_CLEAN$ = F_REG$ THEN GOTO 1040
1030 GOTO 1080
1040 T_CNT% = T_CNT% + 1% \ T_UNI% = T_UNI% + S_UNIT%(TI%) \ T_DOL% = T_DOL% + S_DOL%(TI%)
1050 RG_P$ = LEFT$(R_CLEAN$ + BLANKS$, 8%) \ PR_P$ = LEFT$(S_PROD$(TI%) + BLANKS$, 10%)
1060 PRINT "              "; RG_P$; "  "; PR_P$; "    "; S_UNIT%(TI%); "         $"; S_DOL%(TI%); "K"
1080 TI% = TI% + 1% \ GOTO 990
1090 PRINT SEP$ \ PRINT "  TOTALS ("; T_CNT%; " SEGMENTS)                 "; T_UNI%; "        $"; T_DOL%; "K" \ PRINT EQU$ \ GOTO 495
1150 IF NUM_REC% = 0% THEN GOTO 3370
1160 PRINT EQU$ \ PRINT "  FOCUS DEFINE FILE SALES: AVG_PRICE/I6 = DOLLARS / UNITS; PROFIT_K/I6 = DOLLARS * 25 / 100;" \ PRINT SEP$
