1190 IF DI% > NUM_REC% THEN GOTO 1260
1200 AVG_P% = INT(S_DOL%(DI%) / S_UNIT%(DI%)) \ PRF_V% = INT((S_DOL%(DI%) * 25%) / 100%) \ TOT_PRF% = TOT_PRF% + PRF_V%
1210 PR_P$ = LEFT$(S_PROD$(DI%) + BLANKS$, 10%)
1220 PRINT "  "; PR_P$; " ("; S_REG$(DI%); ") -> AVG_PRICE = $"; AVG_P%; "K/unit | PROFIT_K = $"; PRF_V%; "K"
1240 DI% = DI% + 1% \ GOTO 1190
1260 PRINT SEP$ \ PRINT "  [FOCUS DEFINE Evaluated: "; NUM_REC%; " virtual rows | Total PROFIT_K = $"; TOT_PRF%; "K]" \ PRINT EQU$ \ GOTO 495
1320 IF NUM_REC% = 0% THEN GOTO 3370
1330 PRINT EQU$ \ PRINT "  FOCUS GRAPH FILE SALES SUM DOLLARS BY PROD_CODE (ASCII Histogram)" \ PRINT SEP$
