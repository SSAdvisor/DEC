10 MAP (REC_BUF) STRING MAP_LINE$ = 255% \ DIM S_PROD$(15%) \ DIM S_REG$(15%) \ DIM S_UNIT%(15%) \ DIM S_DOL%(15%)
20 NUM_REC% = 0% \ MAS_NM$ = "SALES.MAS" \ FOC_DB$ = "SALES.FOC" \ DB_FILE$ = "FOCUSDB.DAT"
30 BLANKS$ = "                                                                                "
40 SEP$    = "--------------------------------------------------------------------------------"
50 EQU$    = "================================================================================" \ IS_BATCH% = 0% \ CMD_LINE$ = COMMAND$
60 IF CMD_LINE$ = "" THEN GOTO 80
70 IS_BATCH% = 1% \ SC_REM$ = CMD_LINE$ \ GOTO 170
80 PRINT EQU$ \ PRINT "    Information Builders FOCUS V6.5 - 4GL & Hierarchical/Relational DBMS" \ PRINT "    Information Builders, Inc. (New York, NY) - DEC VAX/VMS Release" \ PRINT EQU$
