1500 IF C1% = 0% THEN GOTO 1600
1510 T_IN$ = LEFT$(ARGS$, C1% - 1%) \ GOSUB 500 \ U_IN$ = T_OUT$ \ GOSUB 580 \ PR_V$ = U_OUT$
1520 REM1$ = MID$(ARGS$, C1% + 1%, LEN(ARGS$) - C1%) \ C2% = INSTR(1%, REM1$, ",")
1530 IF C2% = 0% THEN GOTO 1600
1540 T_IN$ = LEFT$(REM1$, C2% - 1%) \ GOSUB 500 \ U_IN$ = T_OUT$ \ GOSUB 580 \ RG_V$ = U_OUT$
1550 REM2$ = MID$(REM1$, C2% + 1%, LEN(REM1$) - C2%) \ C3% = INSTR(1%, REM2$, ",")
1560 IF C3% = 0% THEN GOTO 1600
1570 UN_V% = VAL(LEFT$(REM2$, C3% - 1%)) \ DL_V% = VAL(MID$(REM2$, C3% + 1%, LEN(REM2$) - C3%))
1580 NUM_REC% = NUM_REC% + 1% \ S_PROD$(NUM_REC%) = PR_V$ \ S_REG$(NUM_REC%) = RG_V$ \ S_UNIT%(NUM_REC%) = UN_V% \ S_DOL%(NUM_REC%) = DL_V%
