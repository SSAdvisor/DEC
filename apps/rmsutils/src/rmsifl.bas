10 ! ================================================================
20 ! RMSIFL - DEC RMS-11 INDEXED FILE LOAD UTILITY
30 ! AUTHENTIC DIGITAL EQUIPMENT CORPORATION RMS-11 LOAD FACILITY
40 ! REIMPLEMENTED IN BASIC-PLUS-2 FOR DEC-APPS
50 ! ================================================================
60 MAP (REC_BUF) STRING MAP_LINE$ = 255%
70 DIM REC$(1000%)
80 DIM SKEY$(1000%)
90 NUM_RECS% = 0%
100 NUM_LOADED% = 0%
110 NUM_DUPS% = 0%
120 IN_FILE$ = ""
130 OUT_FILE$ = ""
140 KEY_POS% = 1%
150 KEY_LEN% = 10%
160 KEY_TYPE$ = "C"
170 CMD$ = COMMAND$
180 IF CMD$ <> "" THEN GOSUB 300
190 IF IN_FILE$ = "" THEN GOSUB 400
200 IF IN_FILE$ = "" OR OUT_FILE$ = "" THEN GOTO 990
210 ! Ensure .IDX extension for target if missing
220 IF INSTR(1%, OUT_FILE$, ".") = 0% THEN OUT_FILE$ = OUT_FILE$ + ".IDX"
230 ! --- READ INPUT FILE ---
240 ON ERROR GOTO 290
250 OPEN IN_FILE$ FOR INPUT AS FILE #1%
260 READ_SEQ_LOOP:
270 LINE INPUT #1%, LINE_BUF$
275 NUM_RECS% = NUM_RECS% + 1%
280 REC$(NUM_RECS%) = LINE_BUF$
285 GOTO 260
290 CLOSE #1%
295 RESUME 600
300 ! --- PARSE COMMAND LINE ---
310 EQ_P% = INSTR(1%, CMD$, "=")
315 IF EQ_P% = 0% THEN GOTO 380
320 OUT_FILE$ = LEFT$(CMD$, EQ_P% - 1%)
325 REM_CMD$ = MID$(CMD$, EQ_P% + 1%, LEN(CMD$) - EQ_P%)
330 SW_P% = INSTR(1%, REM_CMD$, "/POS")
332 IF SW_P% = 0% THEN SW_P% = INSTR(1%, REM_CMD$, "/SIZ")
334 IF SW_P% = 0% THEN SW_P% = INSTR(1%, REM_CMD$, "/KEY")
336 IF SW_P% = 0% THEN SW_P% = INSTR(1%, REM_CMD$, "/NUM")
338 IF SW_P% = 0% THEN SW_P% = INSTR(1%, REM_CMD$, "/CH")
339 IF SW_P% = 0% THEN GOTO 345
340 IN_FILE$ = LEFT$(REM_CMD$, SW_P% - 1%)
342 SW$ = MID$(REM_CMD$, SW_P%, LEN(REM_CMD$) - SW_P% + 1%)
343 GOTO 350
345 IN_FILE$ = REM_CMD$
347 SW$ = ""
350 P_POS% = INSTR(1%, SW$, "/POS:")
352 IF P_POS% = 0% THEN P_POS% = INSTR(1%, SW$, "POS:")
354 IF P_POS% > 0% THEN KEY_POS% = VAL(MID$(SW$, P_POS% + 5%, 4%))
360 P_SIZ% = INSTR(1%, SW$, "/SIZ:")
362 IF P_SIZ% = 0% THEN P_SIZ% = INSTR(1%, SW$, "SIZ:")
364 IF P_SIZ% > 0% THEN KEY_LEN% = VAL(MID$(SW$, P_SIZ% + 5%, 4%))
370 IF INSTR(1%, SW$, "NUM") > 0% THEN KEY_TYPE$ = "N"
375 RETURN
380 ! Positional: IN OUT
382 SP_P% = INSTR(1%, CMD$, " ")
384 IF SP_P% = 0% THEN GOTO 390
386 IN_FILE$ = LEFT$(CMD$, SP_P% - 1%)
388 OUT_FILE$ = MID$(CMD$, SP_P% + 1%, LEN(CMD$) - SP_P%)
390 RETURN
400 ! --- INTERACTIVE PROMPTS ---
405 PRINT "RMSIFL V2.0 - DEC RMS-11 Indexed File Load Utility"
410 PRINT ""
415 INPUT "Source sequential file: "; IN_FILE$
420 IF IN_FILE$ = "" THEN GOTO 480
425 INPUT "Target RMS indexed file: "; OUT_FILE$
430 IF OUT_FILE$ = "" THEN GOTO 480
435 PRINT "Primary key position [1]: ";
440 INPUT POS_IN$
445 IF POS_IN$ <> "" THEN KEY_POS% = VAL(POS_IN$)
450 PRINT "Primary key length [10]: ";
455 INPUT SIZ_IN$
460 IF SIZ_IN$ <> "" THEN KEY_LEN% = VAL(SIZ_IN$)
465 PRINT "Key type (C=Character, N=Numeric) [C]: ";
470 INPUT TYP_IN$
475 IF TYP_IN$ = "N" OR TYP_IN$ = "n" THEN KEY_TYPE$ = "N" ELSE KEY_TYPE$ = "C"
480 RETURN
600 ! --- EXTRACT SORT KEYS ---
605 ON ERROR GOTO 0
610 IF NUM_RECS% = 0% THEN GOTO 900
620 I% = 1%
625 EXTRACT_LOOP:
630 IF I% > NUM_RECS% THEN GOTO 700
635 CUR_LEN% = LEN(REC$(I%))
640 IF KEY_POS% > CUR_LEN% THEN GOTO 663
645 AVAIL_LEN% = CUR_LEN% - KEY_POS% + 1%
650 IF KEY_LEN% < AVAIL_LEN% THEN USE_LEN% = KEY_LEN% ELSE USE_LEN% = AVAIL_LEN%
660 S$ = MID$(REC$(I%), KEY_POS%, USE_LEN%)
662 GOTO 665
663 S$ = ""
665 SKEY$(I%) = S$
670 I% = I% + 1%
675 GOTO 625
700 ! --- SORT RECORDS (ASCENDING PRIMARY KEY) ---
710 I% = 1%
715 SORT_OUTER:
720 IF I% >= NUM_RECS% THEN GOTO 800
725 J% = I% + 1%
730 SORT_INNER:
735 IF J% > NUM_RECS% THEN GOTO 780
736 S1$ = SKEY$(I%)
737 S2$ = SKEY$(J%)
740 IF KEY_TYPE$ = "N" THEN GOTO 750
742 IF S1$ > S2$ THEN GOTO 770 ELSE GOTO 778
750 V1 = VAL(S1$)
752 V2 = VAL(S2$)
754 IF V1 > V2 THEN GOTO 770 ELSE GOTO 778
770 TK$ = SKEY$(I%)
771 TR$ = REC$(I%)
772 TJ$ = SKEY$(J%)
773 SKEY$(I%) = TJ$
774 TJ$ = REC$(J%)
775 REC$(I%) = TJ$
776 SKEY$(J%) = TK$
777 REC$(J%) = TR$
778 J% = J% + 1%
779 GOTO 730
780 I% = I% + 1%
785 GOTO 715
800 ! --- LOAD INTO RMS INDEXED FILE ---
810 ON ERROR GOTO 980
815 OPEN OUT_FILE$ FOR OUTPUT AS FILE #2%, ORGANIZATION INDEXED FIXED, PRIMARY KEY MAP_LINE$, MAP REC_BUF
820 K% = 1%
825 LAST_KEY$ = "~~~NONE~~~"
830 LOAD_LOOP:
835 IF K% > NUM_RECS% THEN GOTO 870
838 CUR_KEY$ = SKEY$(K%)
840 ! Check for duplicate keys
842 IF CUR_KEY$ = LAST_KEY$ THEN GOTO 860
845 LAST_KEY$ = CUR_KEY$
850 MAP_LINE$ = REC$(K%)
852 PUT #2%
854 NUM_LOADED% = NUM_LOADED% + 1%
856 GOTO 865
860 NUM_DUPS% = NUM_DUPS% + 1%
865 K% = K% + 1%
868 GOTO 830
870 CLOSE #2%
875 ON ERROR GOTO 0
880 GOTO 900
900 ! --- PRINT REPORT ---
905 PRINT "RMSIFL V2.0 - DEC RMS-11 Indexed File Load Utility"
910 PRINT "================================================================"
915 PRINT "Source File:        "; IN_FILE$
920 PRINT "Target Indexed:     "; OUT_FILE$
925 PRINT "Records Read:       "; NUM_RECS%
930 PRINT "Records Loaded:     "; NUM_LOADED%
935 PRINT "Duplicate Keys:     "; NUM_DUPS%
940 PRINT "Primary Key Pos:    "; KEY_POS%
945 PRINT "Primary Key Len:    "; KEY_LEN%
950 PRINT "Status:             SUCCESS"
955 PRINT "================================================================"
960 GOTO 999
980 PRINT "RMSIFL: Error creating target indexed file: "; OUT_FILE$
985 GOTO 999
990 PRINT "RMSIFL: Missing source or target file specification."
999 END
