310 PRINT "THE CITY NOW OWNS "; A; " ACRES."
320 PRINT "YOU HARVESTED "; Y; " BUSHELS PER ACRE."
330 PRINT "THE RATS ATE "; E; " BUSHELS."
340 PRINT "YOU NOW HAVE "; S; " BUSHELS IN STORE."
350 PRINT
360 IF Z = 11% THEN 900
370 Y1 = INT(10.0 * RND) + 17%
380 PRINT "LAND IS TRADING AT "; Y1; " BUSHELS PER ACRE."
390 ! --- BUY ACRES ---
400 PRINT "HOW MANY ACRES DO YOU WISH TO BUY";
410 INPUT Q
420 IF Q < 0% THEN 850
430 IF Y1 * Q <= S THEN 460
440 PRINT "HAMURABI:  THINK AGAIN. YOU HAVE ONLY "; S; " BUSHELS OF GRAIN. NOW THEN,"
450 GOTO 400
460 IF Q = 0% THEN 500
470 A = A + Q \ S = S - Y1 * Q
480 GOTO 560
490 ! --- SELL ACRES ---
500 PRINT "HOW MANY ACRES DO YOU WISH TO SELL";
510 INPUT Q
520 IF Q < 0% THEN 850
530 IF Q <= A THEN 555
540 PRINT "HAMURABI:  THINK AGAIN. YOU OWN ONLY "; A; " ACRES. NOW THEN,"
550 GOTO 500
555 A = A - Q \ S = S + Y1 * Q
560 PRINT
570 ! --- FEED PEOPLE ---
580 PRINT "HOW MANY BUSHELS DO YOU WISH TO FEED YOUR PEOPLE";
590 INPUT Q
600 IF Q < 0% THEN 850
610 IF Q <= S THEN 640
620 PRINT "HAMURABI:  THINK AGAIN. YOU HAVE ONLY "; S; " BUSHELS OF GRAIN. NOW THEN,"
630 GOTO 580
640 S = S - Q
650 PRINT
660 ! --- PLANT SEED ---
670 PRINT "HOW MANY ACRES DO YOU WISH TO PLANT WITH SEED";
680 INPUT D
690 IF D < 0% THEN 850
700 IF D = 0% THEN 770
710 IF D <= A THEN 730
720 PRINT "HAMURABI:  THINK AGAIN. YOU OWN ONLY "; A; " ACRES. NOW THEN," \ GOTO 670
730 IF INT(D / 2.0) <= S THEN 750
740 PRINT "HAMURABI:  THINK AGAIN. YOU HAVE ONLY "; S; " BUSHELS OF GRAIN. NOW THEN," \ GOTO 670
750 IF D <= P * 10% THEN 770
760 PRINT "BUT YOU HAVE ONLY "; P; " PEOPLE TO TEND THE FIELDS! NOW THEN," \ GOTO 670
770 S = S - INT(D / 2.0)
780 ! --- HARVEST & RATS ---
782 Y = INT(RND * 5.0) + 1%
784 H = D * Y \ E = 0%
786 C1 = INT(RND * 5.0) + 1%
788 IF INT(C1 / 2.0) * 2% = C1 THEN E = INT(S / C1)
790 S = S - E + H
792 ! --- BIRTHS & IMMIGRATION ---
794 I = INT(RND * (20.0 * A + S) / P / 100.0) + 1%
796 ! --- STARVATION ---
798 C = INT(Q / 20.0)
800 Q = INT(10.0 * (2.0 * RND - 0.3))
802 IF P <= C THEN 820
804 D = P - C
806 IF D <= 0.45 * P THEN 816
808 PRINT
810 PRINT "YOU STARVED "; D; " PEOPLE IN ONE YEAR!!!"
812 PRINT "DUE TO THIS EXTREME MISMANAGEMENT YOU HAVE NOT ONLY"
814 PRINT "BEEN IMPEACHED AND THROWN OUT OF OFFICE BUT YOU HAVE"
815 PRINT "ALSO BEEN DECLARED NATIONAL FINK!!!!"
817 GOTO 990
816 P1 = ((Z - 1%) * P1 + D * 100.0 / P) / Z
818 P = C \ D1 = D1 + D
819 GOTO 210
820 D = 0%
822 GOTO 210
850 ! --- NEGATIVE INPUT CHEAT ---
860 PRINT
870 PRINT "HAMURABI:  I CANNOT DO WHAT YOU WISH."
880 PRINT "GET YOURSELF ANOTHER STEWARD!!!!!"
890 GOTO 990
900 ! --- 10-YEAR EVALUATION ---
902 PRINT "IN YOUR 10-YEAR TERM OF OFFICE, "; P1; " PERCENT OF THE"
904 PRINT "POPULATION STARVED PER YEAR ON THE AVERAGE, I.E. A TOTAL OF"
906 PRINT D1; " PEOPLE DIED!!"
908 L = A / P
910 PRINT "YOU STARTED WITH 10 ACRES/PERSON AND ENDED WITH "; L; " ACRES/PERSON."
912 PRINT
914 IF P1 > 33.0 OR L < 7.0 THEN 940
916 IF P1 > 10.0 OR L < 9.0 THEN 950
918 IF P1 > 3.0 OR L < 10.0 THEN 960
920 PRINT "A FANTASTIC PERFORMANCE!!! CHARLEMAGNE, DISRAELI, AND"
922 PRINT "JEFFERSON COMBINED COULD NOT HAVE DONE BETTER!"
924 GOTO 990
940 PRINT "DUE TO EXTREME MISMANAGEMENT YOU HAVE BEEN DECLARED NATIONAL FINK!"
942 GOTO 990
950 PRINT "YOUR HEAVY-HANDED PERFORMANCE SMACKS OF NERO AND IVAN IV."
952 PRINT "THE PEOPLE (REMAINING) FIND YOU AN UNPLEASANT RULER."
954 GOTO 990
960 PRINT "YOUR PERFORMANCE COULD HAVE BEEN WORSE, BUT 56 PEOPLE"
962 PRINT "WOULD DEARLY LIKE TO SEE YOU ASSASSINATED."
990 PRINT
992 PRINT "SO LONG FOR NOW."
994 PRINT
