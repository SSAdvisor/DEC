130 PRINT "TERM OF OFFICE."
140 PRINT
150 D1 = 0.0 \ P1 = 0.0
160 Z = 0% \ P = 100% \ S = 2800% \ H = 3000% \ E = 200%
170 A = 1000% \ I = 5% \ Q = 1% \ D = 0%
180 Y = 3%
190 C = 0%
200 ! --- MAIN YEAR LOOP ---
210 Z = Z + 1%
220 PRINT
230 PRINT "HAMURABI:  I BEG TO REPORT TO YOU,"
240 PRINT "IN YEAR "; Z; ", "; D; " PEOPLE STARVED, "; I; " CAME TO THE CITY."
250 P = P + I
260 IF Q > 0% THEN 300
270 P = INT(P / 2%)
280 PRINT "A HORRIBLE PLAGUE STRUCK!  HALF THE PEOPLE DIED."
