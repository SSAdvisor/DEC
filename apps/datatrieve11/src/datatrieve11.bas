3380 IF CI% > NUM_COLL% THEN GOTO 3400
3390 RI% = COLL%(CI%) \ REC_IN$ = RECS$(RI%) \ GOSUB 540 \ FLD_VAL$(F_IDX%) = NEW_VAL$ \ GOSUB 620 \ RECS$(RI%) = REC_OUT$ \ CI% = CI% + 1% \ GOTO 3380
3400 GOSUB 1270 \ PRINT "["; NUM_COLL%; " record(s) modified in "; ACT_DOM$; "]" \ GOTO 500
3410 IF ACT_DOM$ = "" THEN GOTO 510
3420 IF NUM_COLL% = 0% THEN GOTO 520
3430 DEL_COUNT% = NUM_COLL% \ NEW_N% = 0% \ RI% = 1%
3440 IF RI% > NUM_RECS% THEN GOTO 3520
3450 IN_C% = 0% \ CI% = 1%
3460 IF CI% > NUM_COLL% THEN GOTO 3490
3470 IF COLL%(CI%) = RI% THEN IN_C% = 1%
3480 CI% = CI% + 1% \ GOTO 3460
3490 IF IN_C% = 1% THEN GOTO 3510
3500 NEW_N% = NEW_N% + 1% \ RECS$(NEW_N%) = RECS$(RI%)
3510 RI% = RI% + 1% \ GOTO 3440
3520 NUM_RECS% = NEW_N% \ NUM_COLL% = 0% \ GOSUB 1270 \ PRINT "["; DEL_COUNT%; " record(s) erased from "; ACT_DOM$; "]" \ GOTO 500
3530 IF ACT_DOM$ = "" THEN GOTO 510
3540 IF NUM_COLL% = 0% THEN GOSUB 880
3550 IF NUM_COLL% = 0% THEN GOTO 520
3560 U_IN$ = ARGS$ \ GOSUB 760 \ F_REQ$ = U_OUT$
3570 IF F_REQ$ = "" THEN F_REQ$ = FLD_NAME$(NUM_FIELDS%)
3580 GOSUB 820
3590 IF F_IDX% = 0% THEN GOTO 3620
3600 IF FLD_TYPE$(F_IDX%) <> "N" THEN GOTO 3630
3610 GOTO 3640
3620 PRINT "DTR: Unknown field '"; F_REQ$; "'" \ GOTO 500
3630 PRINT "DTR: Field '"; F_REQ$; "' is not numeric." \ GOTO 500
3640 SUM_V = 0 \ CI% = 1% \ RI% = COLL%(1%) \ REC_IN$ = RECS$(RI%) \ GOSUB 540 \ MIN_V = VAL(FLD_VAL$(F_IDX%)) \ MAX_V = MIN_V
3650 IF CI% > NUM_COLL% THEN GOTO 3700
3660 RI% = COLL%(CI%) \ REC_IN$ = RECS$(RI%) \ GOSUB 540 \ V = VAL(FLD_VAL$(F_IDX%)) \ SUM_V = SUM_V + V
3670 IF V < MIN_V THEN MIN_V = V
3680 IF V > MAX_V THEN MAX_V = V
3690 CI% = CI% + 1% \ GOTO 3650
3700 AVG_V = SUM_V / NUM_COLL% \ PRINT "Statistics for "; ACT_DOM$; "."; FLD_NAME$(F_IDX%); " ("; NUM_COLL%; " records):"
3710 PRINT "  Count:    "; NUM_COLL% \ PRINT "  Total:    "; SUM_V \ PRINT "  Average:  "; AVG_V \ PRINT "  Minimum:  "; MIN_V \ PRINT "  Maximum:  "; MAX_V \ GOTO 500
3720 IF ACT_DOM$ = "" THEN GOTO 510
3730 IF NUM_COLL% = 0% THEN GOSUB 880
3740 IF NUM_COLL% = 0% THEN GOTO 520
3750 OUT_FILE$ = "" \ ON_P% = INSTR(1%, ARGS$, "ON ") \ DO_FILE% = 0%
3760 IF ON_P% = 0% THEN GOTO 3800
3770 OUT_FILE$ = MID$(ARGS$, ON_P% + 3%, LEN(ARGS$) - ON_P% - 2%) \ T_IN$ = OUT_FILE$ \ GOSUB 680 \ OUT_FILE$ = T_OUT$
3780 IF OUT_FILE$ = "" THEN GOTO 3800
3790 DO_FILE% = 1% \ OPEN OUT_FILE$ FOR OUTPUT AS FILE #2%
3800 TITLE$ = "DEC DATATRIEVE-11 REPORT: " + ACT_DOM$ \ PRINT TITLE$
3810 IF DO_FILE% = 1% THEN PRINT #2%, TITLE$
3820 HDR$ = "" \ DIV$ = "" \ FI% = 1%
3830 IF FI% > NUM_FIELDS% THEN GOTO 3870
3840 W% = FLD_WIDTH%(FI%)
3850 IF W% < LEN(FLD_NAME$(FI%)) THEN W% = LEN(FLD_NAME$(FI%))
3860 FLD_WIDTH%(FI%) = W% \ HDR$ = HDR$ + LEFT$(FLD_NAME$(FI%) + BLANKS$, W% + 2%) \ DIV$ = DIV$ + LEFT$(SEP$, W% + 2%) \ FI% = FI% + 1% \ GOTO 3830
3870 PRINT HDR$ \ PRINT DIV$
3880 IF DO_FILE% = 1% THEN PRINT #2%, HDR$ \ PRINT #2%, DIV$
3890 CI% = 1%
3900 IF CI% > NUM_COLL% THEN GOTO 4030
3910 RI% = COLL%(CI%) \ REC_IN$ = RECS$(RI%) \ GOSUB 540 \ ROW$ = "" \ FI% = 1%
3920 IF FI% > NUM_FIELDS% THEN GOTO 4000
3930 W% = FLD_WIDTH%(FI%) \ V$ = FLD_VAL$(FI%)
3940 IF FLD_TYPE$(FI%) = "N" THEN GOTO 3960
3950 ROW$ = ROW$ + LEFT$(V$ + BLANKS$, W% + 2%) \ GOTO 3990
3960 PAD_N% = W% - LEN(V$)
3970 IF PAD_N% < 0% THEN PAD_N% = 0%
3980 ROW$ = ROW$ + LEFT$(BLANKS$, PAD_N%) + V$ + "  "
3990 FI% = FI% + 1% \ GOTO 3920
4000 PRINT ROW$
4010 IF DO_FILE% = 1% THEN PRINT #2%, ROW$
4020 CI% = CI% + 1% \ GOTO 3900
4030 PRINT DIV$
4040 IF DO_FILE% = 1% THEN PRINT #2%, DIV$
4050 TOT_ROW$ = "TOTALS:       " \ IF NUM_FIELDS% >= 2% THEN TOT_ROW$ = TOT_ROW$ + LEFT$(BLANKS$, 20%)
4060 PRINT TOT_ROW$; "["; NUM_COLL%; " Records Processed]"
4070 IF DO_FILE% = 0% THEN GOTO 500
4080 PRINT #2%, TOT_ROW$; "["; NUM_COLL%; " Records Processed]" \ CLOSE #2% \ PRINT "[Report written to "; OUT_FILE$; "]" \ GOTO 500
4090 IF ACT_DOM$ = "" THEN GOTO 510
4100 IF NUM_COLL% = 0% THEN GOSUB 880
4110 IF NUM_COLL% = 0% THEN GOTO 520
4120 U_IN$ = ARGS$ \ GOSUB 760 \ P_ARGS$ = U_OUT$ \ SP% = INSTR(1%, P_ARGS$, " ")
4130 IF SP% = 0% THEN GOTO 4150
4140 LBL_REQ$ = LEFT$(P_ARGS$, SP% - 1%) \ VAL_REQ$ = MID$(P_ARGS$, SP% + 1%, LEN(P_ARGS$) - SP%) \ GOTO 4160
4150 LBL_REQ$ = FLD_NAME$(1%) \ VAL_REQ$ = P_ARGS$
4160 IF VAL_REQ$ = "" THEN VAL_REQ$ = FLD_NAME$(NUM_FIELDS%)
4170 F_REQ$ = LBL_REQ$ \ GOSUB 820 \ L_IDX% = F_IDX% \ F_REQ$ = VAL_REQ$ \ GOSUB 820 \ V_IDX% = F_IDX%
4180 IF L_IDX% = 0% THEN L_IDX% = 1%
4190 IF V_IDX% = 0% THEN V_IDX% = NUM_FIELDS%
4200 MAX_V = 1 \ CI% = 1%
4210 IF CI% > NUM_COLL% THEN GOTO 4250
4220 RI% = COLL%(CI%) \ REC_IN$ = RECS$(RI%) \ GOSUB 540 \ V = VAL(FLD_VAL$(V_IDX%))
4230 IF V > MAX_V THEN MAX_V = V
4240 CI% = CI% + 1% \ GOTO 4210
4250 PRINT "DATATRIEVE PLOT: "; FLD_NAME$(V_IDX%); " by "; FLD_NAME$(L_IDX%) \ PRINT SEP$ \ CI% = 1%
4260 IF CI% > NUM_COLL% THEN GOTO 4310
4270 RI% = COLL%(CI%) \ REC_IN$ = RECS$(RI%) \ GOSUB 540 \ LBL$ = LEFT$(FLD_VAL$(L_IDX%) + BLANKS$, 14%) \ V = VAL(FLD_VAL$(V_IDX%)) \ BAR_LEN% = INT(V * 40 / MAX_V)
4280 IF BAR_LEN% < 1% THEN BAR_LEN% = 1%
4290 IF BAR_LEN% > 40% THEN BAR_LEN% = 40%
4300 BAR$ = LEFT$(STARS$, BAR_LEN%) \ PRINT LBL$; " | "; BAR$; " ("; FLD_VAL$(V_IDX%); ")" \ CI% = CI% + 1% \ GOTO 4260
4310 PRINT SEP$ \ GOTO 500
4320 IF ACT_DOM$ = "" THEN GOTO 510
4330 IF ARGS$ = "" THEN GOTO 4350
4340 GOTO 4360
4350 PRINT "DTR: Specify export filename" \ GOTO 500
4360 OPEN ARGS$ FOR OUTPUT AS FILE #2% \ CI% = 1%
4370 IF CI% > NUM_COLL% THEN GOTO 4390
4380 RI% = COLL%(CI%) \ PRINT #2%, RECS$(RI%) \ CI% = CI% + 1% \ GOTO 4370
4390 CLOSE #2% \ PRINT "["; NUM_COLL%; " record(s) exported to "; ARGS$; "]" \ GOTO 500
4400 IF ACT_DOM$ = "" THEN GOTO 510
4410 IF ARGS$ = "" THEN GOTO 4430
4420 GOTO 4440
4430 PRINT "DTR: Specify import filename" \ GOTO 500
4440 ON ERROR GOTO 4480 \ OPEN ARGS$ FOR INPUT AS FILE #2%
4450 LINE INPUT #2%, T_LINE$ \ T_IN$ = T_LINE$ \ GOSUB 680
4460 IF T_OUT$ = "" THEN GOTO 4450
4470 NUM_RECS% = NUM_RECS% + 1% \ RECS$(NUM_RECS%) = T_OUT$ \ NUM_COLL% = NUM_COLL% + 1% \ COLL%(NUM_COLL%) = NUM_RECS% \ GOTO 4450
4480 CLOSE #2% \ RESUME 4490
4490 ON ERROR GOTO 0 \ GOSUB 1270 \ PRINT "[Import complete - domain now has "; NUM_RECS%; " records]" \ GOTO 500
4500 PRINT EQU$ \ PRINT "    DATATRIEVE-11 Query & Data Management Commands" \ PRINT EQU$ \ PRINT "  READY <domain>              Open and load a data domain (e.g. READY YACHTS)"
4510 PRINT "  FINISH                      Save and close the active domain" \ PRINT "  SHOW DOMAINS|RECORDS|ALL    Display domains, record layout, or status"
4520 PRINT "  DEFINE DOMAIN <name>        Create a new domain and schema" \ PRINT "  FIND [ALL] [WITH cond]      Query records (WITH field op val) [SORTED BY field]"
4530 PRINT "  PRINT [FIRST n] [ALL]       Display collection records in tabular format" \ PRINT "  SELECT <rec#>               Select and inspect individual record"
4540 PRINT "  SORT [BY] <field> [ASC|DESC]Sort current collection" \ PRINT "  STORE                       Interactively add a new record to domain"
4550 PRINT "  MODIFY <field> = <value>    Update field value across collection" \ PRINT "  ERASE [ALL]                 Delete records in collection from domain"
4560 PRINT "  TOTAL|STATS|AVERAGE <field> Compute summary statistics for numeric field" \ PRINT "  REPORT [ON <file>]          Generate tabular report with column totals"
4570 PRINT "  PLOT <lbl_field> <val_fld>  Draw ASCII horizontal bar chart" \ PRINT "  EXPORT <file> / IMPORT <f>  Data interchange"
4580 PRINT "  EXIT / QUIT / BYE           Terminate DATATRIEVE session" \ PRINT EQU$ \ GOTO 500
4590 IF ACT_DOM$ <> "" THEN GOSUB 1270
4600 END
