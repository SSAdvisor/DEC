3740 REP_TITLE$ = ARGS$
3750 IF REP_TITLE$ = "" THEN REP_TITLE$ = "Database Report: " + DB_NAME$
3760 PRINT EQU$ \ PRINT "    DEC ADE REPORT: "; REP_TITLE$ \ PRINT "    Database: "; DB_NAME$; "          Records: "; NUM_RECS% \ PRINT SEP$
3770 HDR_LINE$ = "REC#  " \ HI% = 1%
3780 IF HI% > NUM_FIELDS% THEN GOTO 3810
3790 F_IN$ = FLD_NAME$(HI%) \ F_WIDTH% = FLD_WIDTH%(HI%) + 1% \ GOSUB 1040
3800 HDR_LINE$ = HDR_LINE$ + F_OUT$ \ HI% = HI% + 1% \ GOTO 3780
3810 PRINT HDR_LINE$ \ PRINT SEP$ \ K% = 1%
3820 IF K% > NUM_RECS% THEN GOTO 3910
3830 REC_IN$ = RECS$(K%) \ GOSUB 740
3840 S_R$ = STR$(K%)
3850 IF LEFT$(S_R$, 1%) = " " THEN S_R$ = MID$(S_R$, 2%, LEN(S_R$) - 1%)
3860 F_IN$ = S_R$ \ F_WIDTH% = 6% \ GOSUB 1040 \ R_LINE$ = F_OUT$ \ RI% = 1%
3870 IF RI% > NUM_FIELDS% THEN GOTO 3900
3880 F_IN$ = FLD_VAL$(RI%) \ F_WIDTH% = FLD_WIDTH%(RI%) + 1% \ GOSUB 1040
3890 R_LINE$ = R_LINE$ + F_OUT$ \ RI% = RI% + 1% \ GOTO 3870
3900 PRINT R_LINE$ \ K% = K% + 1% \ GOTO 3820
3910 PRINT SEP$ \ TOT_LINE$ = "TOTAL " \ TI% = 1%
3920 IF TI% > NUM_FIELDS% THEN GOTO 4020
3930 IF FLD_TYPE$(TI%) <> "N" THEN F_IN$ = ""
3940 IF FLD_TYPE$(TI%) <> "N" THEN GOTO 4010
3950 COL_TOT = 0 \ TK% = 1%
3960 IF TK% > NUM_RECS% THEN GOTO 3980
3970 REC_IN$ = RECS$(TK%) \ GOSUB 740 \ COL_TOT = COL_TOT + VAL(FLD_VAL$(TI%)) \ TK% = TK% + 1% \ GOTO 3960
3980 S_TOT$ = STR$(COL_TOT)
3990 IF LEFT$(S_TOT$, 1%) = " " THEN S_TOT$ = MID$(S_TOT$, 2%, LEN(S_TOT$) - 1%)
4000 F_IN$ = S_TOT$
4010 F_WIDTH% = FLD_WIDTH%(TI%) + 1% \ GOSUB 1040 \ TOT_LINE$ = TOT_LINE$ + F_OUT$ \ TI% = TI% + 1% \ GOTO 3920
4020 PRINT TOT_LINE$ \ PRINT EQU$ \ GOTO 700
4030 IF DB_NAME$ = "" THEN GOTO 710
4040 IF NUM_RECS% = 0% THEN GOTO 720
4050 SP% = INSTR(1%, ARGS$, " ")
4060 IF SP% = 0% THEN PRINT "ADE: Syntax is GRAPH <label_field> <numeric_value_field>"
4070 IF SP% = 0% THEN GOTO 700
4080 L_NAME$ = LEFT$(ARGS$, SP% - 1%) \ V_NAME$ = MID$(ARGS$, SP% + 1%, LEN(ARGS$) - SP%)
4090 U_IN$ = L_NAME$ \ GOSUB 970 \ L_NAME$ = U_OUT$
4100 U_IN$ = V_NAME$ \ GOSUB 970 \ V_NAME$ = U_OUT$
4110 L_IDX% = 0% \ V_IDX% = 0% \ GI% = 1%
4120 IF GI% > NUM_FIELDS% THEN GOTO 4170
4130 U_IN$ = FLD_NAME$(GI%) \ GOSUB 970
4140 IF U_OUT$ = L_NAME$ THEN L_IDX% = GI%
4150 IF U_OUT$ = V_NAME$ THEN V_IDX% = GI%
4160 GI% = GI% + 1% \ GOTO 4120
4170 IF L_IDX% = 0% THEN PRINT "ADE: Label field '"; L_NAME$; "' not found."
4180 IF L_IDX% = 0% THEN GOTO 700
4190 IF V_IDX% = 0% THEN PRINT "ADE: Value field '"; V_NAME$; "' not found."
4200 IF V_IDX% = 0% THEN GOTO 700
4210 IF FLD_TYPE$(V_IDX%) <> "N" THEN PRINT "ADE: Value field '"; V_NAME$; "' must be numeric."
4220 IF FLD_TYPE$(V_IDX%) <> "N" THEN GOTO 700
4230 G_MAX = 0 \ GK% = 1%
4240 IF GK% > NUM_RECS% THEN GOTO 4280
4250 REC_IN$ = RECS$(GK%) \ GOSUB 740 \ GV = VAL(FLD_VAL$(V_IDX%))
4260 IF GV > G_MAX THEN G_MAX = GV
4270 GK% = GK% + 1% \ GOTO 4240
4280 IF G_MAX <= 0 THEN G_MAX = 1
4290 PRINT EQU$ \ PRINT "    DEC ADE Bar Chart: "; DB_NAME$; " ("; L_NAME$; " vs "; V_NAME$; ")" \ PRINT SEP$ \ GK% = 1%
4300 IF GK% > NUM_RECS% THEN GOTO 4380
4310 REC_IN$ = RECS$(GK%) \ GOSUB 740 \ LAB$ = FLD_VAL$(L_IDX%)
4320 F_IN$ = LAB$ \ F_WIDTH% = 15% \ GOSUB 1040 \ LAB$ = F_OUT$
4330 GV = VAL(FLD_VAL$(V_IDX%)) \ BAR_LEN% = INT((GV / G_MAX) * 50)
4340 IF BAR_LEN% < 0% THEN BAR_LEN% = 0%
4350 IF BAR_LEN% > 50% THEN BAR_LEN% = 50%
4360 BAR$ = LEFT$(STARS$, BAR_LEN%)
4370 PRINT LAB$; " | "; BAR$; " ("; GV; ")" \ GK% = GK% + 1% \ GOTO 4300
4380 PRINT SEP$ \ SCALE_FAC = G_MAX / 50 \ S_FAC$ = STR$(SCALE_FAC)
4390 IF LEFT$(S_FAC$, 1%) = " " THEN S_FAC$ = MID$(S_FAC$, 2%, LEN(S_FAC$) - 1%)
4400 PRINT "Scale: 1 '*' = "; S_FAC$; " units" \ PRINT EQU$ \ GOTO 700
4410 IF DB_NAME$ = "" THEN GOTO 710
4420 EXP_FILE$ = ARGS$
4430 IF EXP_FILE$ = "" THEN PRINT "ADE: Target export filename required."
4440 IF EXP_FILE$ = "" THEN GOTO 700
4450 ON ERROR GOTO 4500
4460 OPEN EXP_FILE$ FOR OUTPUT AS FILE #1% \ EK% = 1%
4470 IF EK% > NUM_RECS% THEN GOTO 4490
4480 PRINT #1%, RECS$(EK%) \ EK% = EK% + 1% \ GOTO 4470
4490 CLOSE #1% \ ON ERROR GOTO 0 \ PRINT "Exported "; NUM_RECS%; " records to '"; EXP_FILE$; "'." \ GOTO 700
4500 CLOSE #1% \ ON ERROR GOTO 0 \ PRINT "ADE: Error exporting to file '"; EXP_FILE$; "'." \ GOTO 700
4510 IF DB_NAME$ = "" THEN GOTO 710
4520 IMP_FILE$ = ARGS$
4530 IF IMP_FILE$ = "" THEN PRINT "ADE: Source import filename required."
4540 IF IMP_FILE$ = "" THEN GOTO 700
4550 ON ERROR GOTO 4600
4560 OPEN IMP_FILE$ FOR INPUT AS FILE #1% \ IMP_CNT% = 0%
4570 LINE INPUT #1%, IMP_LINE$ \ T_IN$ = IMP_LINE$ \ GOSUB 890
4580 IF T_OUT$ = "" THEN GOTO 4570
4590 NUM_RECS% = NUM_RECS% + 1% \ RECS$(NUM_RECS%) = T_OUT$ \ IMP_CNT% = IMP_CNT% + 1% \ GOTO 4570
4600 CLOSE #1%
4610 IF ERR = 5% THEN GOTO 4640
4620 ON ERROR GOTO 0 \ GOSUB 1100
4630 PRINT "Imported "; IMP_CNT%; " records from '"; IMP_FILE$; "'. Total: "; NUM_RECS%; "." \ GOTO 700
4640 ON ERROR GOTO 0
4650 PRINT "ADE: Error reading import file '"; IMP_FILE$; "'." \ GOTO 700
4660 END
