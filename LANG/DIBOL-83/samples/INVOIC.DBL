; DEC CTS-500 / RSTS/E DIBOL-83 V5.3 COMMERCIAL INVOICE MODULE
.TITLE 'INVOIC - DEC DIBOL-83 BILLING'
RECORD
    CUST_NAME,   A24, 'DIGITAL EQUIPMENT CORP'
    ITEM_QTY,    D4,  12
    UNIT_PRICE,  D6,  150
    DISC_AMT,    D6,  100
    NET_TOTAL,   D8,  0
PROC
    XCALL FLAGS(7000000, 1)
    OPEN(1, O, 'TT:')
    CALL CALC_INV
    DISPLAY(1, 'DIBOL-83 CUSTOMER: ', CUST_NAME)
    DISPLAY(1, 'INVOICE NET TOTAL: ', NET_TOTAL)
    CLOSE 1
    STOP
CALC_INV,
    NET_TOTAL = (ITEM_QTY * UNIT_PRICE) - DISC_AMT
    RETURN
END
