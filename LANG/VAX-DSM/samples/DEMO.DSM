DEMO ; DEC VAX DSM V6.0 — Hospital Patient Global Database Demo (DEMO.DSM)
 WRITE "DEC VAX DSM V6.0-00 — DIGITAL STANDARD MUMPS",!
 KILL ^PATIENT
 SET ^PATIENT(101)="BELL,GORDON^CARDIOLOGY^ADMITTED"
 SET ^PATIENT(101,"LAB","WBC")=6800
 SET ^PATIENT(102)="CUTLER,DAVE^NEUROLOGY^DISCHARGED"
 SET ^PATIENT(102,"LAB","WBC")=7200
 SET TOTAL=0,ID=""
 FOR  SET ID=$ORDER(^PATIENT(ID)) QUIT:ID=""  DO REPORT
 WRITE "TOTAL PATIENTS=",TOTAL," DATA(101)=",$DATA(^PATIENT(101)),!
 HALT
REPORT ; Print patient record using $PIECE and $EXTRACT
 SET REC=^PATIENT(ID)
 SET NAME=$PIECE(REC,"^",1)
 SET DEPT=$PIECE(REC,"^",2)
 SET STAT=$EXTRACT($PIECE(REC,"^",3),1,3)
 SET TOTAL=TOTAL+1
 WRITE "ID=",ID," NAME=",NAME,?28,"DEPT=",DEPT," [",STAT,"]",!
 QUIT
