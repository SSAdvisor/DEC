10 DIM N$(10)
50 LET C = 0
60 LET S = 0
70 LET F = 0
80 LET M$ = "WELCOME"
90 LET I = 0
100 LET Q$ = ""

1000 REM MAIN LOOP TOP
1010 PRINT "AT MAIN LOOP, S="; S; " F="; F
1060 IF S = 0 THEN GOTO 2000
1070 IF S = 1 THEN GOTO 3000

1100 REM WAIT FOR INPUT
1110 PRINT "WAITING FOR INPUT..."
1120 LET K$ = INKEY$
1125 PRINT "GOT KEY!"
1130 IF K$ = "" THEN GOTO 1110
1140 IF S = 0 THEN GOTO 2500
1150 IF S = 1 THEN GOTO 3500
1180 GOTO 1000

2000 REM DRAW MENU
2010 PRINT "DRAWING MENU"
2110 GOTO 1100

2500 REM HANDLE MENU INPUT
2510 IF K$ = CHR$(9) THEN GOTO 2540
2520 IF K$ = CHR$(10) THEN GOTO 2600
2530 GOTO 1000
2540 LET F = F + 1
2550 IF F > 3 THEN LET F = 0
2560 GOTO 1000
2600 REM MENU ACTION
2610 IF F = 0 THEN LET S = 1
2620 IF F = 0 THEN LET F = 0
2630 IF F = 0 THEN LET M$ = "ENTER"
2770 IF F = 3 THEN GOTO 9000
2780 GOTO 1000

3000 REM DRAW ADD FORM
3010 PRINT "DRAWING FORM"
3150 GOTO 1100

3500 REM HANDLE ADD FORM
3510 IF K$ = CHR$(9) THEN GOTO 3540
3520 IF K$ = CHR$(10) THEN GOTO 3600
3530 GOTO 1000
3540 LET F = F + 1
3550 IF F > 5 THEN LET F = 0
3560 GOTO 1000
3600 REM FORM ACTION
3610 IF F = 4 THEN LET C = C + 1
3650 IF F = 4 THEN GOTO 1000
3780 GOTO 1000

9000 PRINT "GOODBYE!"
9010 END
