! ==============================================================================
! DEC RSTS/E BASIC-PLUS-2 Compiler (basicc)
! Written in pure DEC BASIC-PLUS-2
! ==============================================================================
DIM ARG$(50%)
DIM VAR_NAME$(300%)
DIM LINE_NUM%(500%)
DIM LINE_LBL$(500%)
DIM LINE_OFF%(500%)
DIM REL_OFF%(500%)
DIM REL_TYPE$(500%)
DIM REL_TGT_NUM%(500%)
DIM REL_TGT_NAME$(500%)
DIM FOR_VAR%(20%)
DIM FOR_START%(20%)
DIM FOR_JMP%(20%)
DIM FOR_STEP%(20%)
DIM IF_JMP%(20%)
DIM IF_TYPE$(20%)
DIM MAP_NAME$(20%)
DIM MAP_VARS$(20%, 20%)
DIM MAP_VAR_CNT%(20%)
DIM DATA_INT%(100%)
DIM DATA_STR$(100%)
DIM DATA_TYPE%(100%)
DIM BC%(32000%)
DIM STK_OP$(30%)
DIM STK_REXP$(30%)
LET ESP% = 0%
LET HEX_CHARS$ = "0123456789ABCDEF"
LET Q$ = CHR$(34%)
LET NUM_ARGS% = 0%
LET NUM_VARS% = 0%
LET NUM_LINES% = 0%
LET NUM_RELS% = 0%
LET NUM_MAPS% = 0%
LET NUM_DATA% = 0%
LET FOR_SP% = 0%
LET IF_SP% = 0%
LET BC_LEN% = 0%
LET IN_FILE$ = ""
LET OUT_BOBJ$ = "out.obj"
LET OUT_BIN$ = "out.bin"
LET MOD_NAME$ = "MAIN"
LET ERR_VAR_IDX% = 0%

! Parse command line arguments
LET CMD_ARGS$ = COMMAND$
LET P% = 1%
PARSE_ARGS:
IF P% > LEN(CMD_ARGS$) THEN GOTO PARSE_ARGS_DONE
IF MID$(CMD_ARGS$, P%, 1%) <> " " THEN GOTO FOUND_ARG_START
LET P% = P% + 1%
GOTO PARSE_ARGS

FOUND_ARG_START:
LET START_P% = P%
SCAN_ARG:
IF P% > LEN(CMD_ARGS$) THEN GOTO GOT_ARG
IF MID$(CMD_ARGS$, P%, 1%) = " " THEN GOTO GOT_ARG
LET P% = P% + 1%
GOTO SCAN_ARG

GOT_ARG:
LET NUM_ARGS% = NUM_ARGS% + 1%
LET ARG$(NUM_ARGS%) = MID$(CMD_ARGS$, START_P%, P% - START_P%)
GOTO PARSE_ARGS

PARSE_ARGS_DONE:
IF NUM_ARGS% < 1% THEN
  PRINT "Usage: basicc <input.bas> [-o output.obj] [--module NAME]"
  END
END IF

LET I% = 1%
PROCESS_FLAGS:
IF I% > NUM_ARGS% THEN GOTO FLAGS_DONE
IF ARG$(I%) = "-o" THEN
  IF I% < NUM_ARGS% THEN LET OUT_BOBJ$ = ARG$(I% + 1%)
  LET I% = I% + 2%
  GOTO PROCESS_FLAGS
END IF
IF ARG$(I%) = "--module" THEN
  IF I% < NUM_ARGS% THEN LET MOD_NAME$ = ARG$(I% + 1%)
  LET I% = I% + 2%
  GOTO PROCESS_FLAGS
END IF
IF LEFT$(ARG$(I%), 1%) <> "-" AND IN_FILE$ = "" THEN
  LET IN_FILE$ = ARG$(I%)
END IF
LET I% = I% + 1%
GOTO PROCESS_FLAGS

FLAGS_DONE:
IF IN_FILE$ = "" THEN
  PRINT "Error: No input file specified"
  END
END IF

IF INSTR(1%, OUT_BOBJ$, ".OBJ") > 0% THEN
  LET P% = INSTR(1%, OUT_BOBJ$, ".OBJ")
  LET OUT_BIN$ = LEFT$(OUT_BOBJ$, P% - 1%) + ".bin"
ELSE
  IF INSTR(1%, OUT_BOBJ$, ".obj") > 0% THEN
    LET P% = INSTR(1%, OUT_BOBJ$, ".obj")
    LET OUT_BIN$ = LEFT$(OUT_BOBJ$, P% - 1%) + ".bin"
  ELSE
    LET OUT_BIN$ = OUT_BOBJ$ + ".bin"
  END IF
END IF

! --- Pass 1: Scan source file for DATA statements ---
ON ERROR GOTO PASS1_DONE
OPEN IN_FILE$ FOR INPUT AS FILE #1%
PASS1_LOOP:
LINE INPUT #1%, RAW_LINE$
IF RAW_LINE$ = "" THEN GOTO PASS1_LOOP
GOSUB STRIP_COMMENTS
IF RAW_LINE$ = "" THEN GOTO PASS1_LOOP
IF INSTR(1%, RAW_LINE$, "DATA ") > 0% THEN
  LET P% = INSTR(1%, RAW_LINE$, "DATA ") + 5%
  LET REST_DATA$ = MID$(RAW_LINE$, P%, LEN(RAW_LINE$) - P% + 1%)
  GOSUB PARSE_DATA_ITEMS
END IF
GOTO PASS1_LOOP

PASS1_DONE:
CLOSE #1%
ON ERROR GOTO 0

! Emit DATA initialization header if DATA statements exist
IF NUM_DATA% > 0% THEN
  LET BC%(BC_LEN%) = 118%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = NUM_DATA% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = INT(NUM_DATA% / 256%) AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  FOR J% = 1% TO NUM_DATA%
    LET DTYPE% = DATA_TYPE%(J%)
    LET BC%(BC_LEN%) = DTYPE%
    LET BC_LEN% = BC_LEN% + 1%
    IF DTYPE% = 0% THEN
      LET IVAL% = DATA_INT%(J%)
      LET BC%(BC_LEN%) = IVAL% AND 255%
      LET BC_LEN% = BC_LEN% + 1%
      LET BC%(BC_LEN%) = INT(IVAL% / 256%) AND 255%
      LET BC_LEN% = BC_LEN% + 1%
      LET BC%(BC_LEN%) = 0%
      LET BC_LEN% = BC_LEN% + 1%
      LET BC%(BC_LEN%) = 0%
      LET BC_LEN% = BC_LEN% + 1%
    END IF
    IF DTYPE% = 2% THEN
      LET SVAL$ = DATA_STR$(J%)
      LET SLEN% = LEN(SVAL$)
      LET BC%(BC_LEN%) = SLEN% AND 255%
      LET BC_LEN% = BC_LEN% + 1%
      FOR K% = 1% TO SLEN%
        LET BC%(BC_LEN%) = ASCII(MID$(SVAL$, K%, 1%))
        LET BC_LEN% = BC_LEN% + 1%
      NEXT K%
    END IF
  NEXT J%
END IF

! --- Pass 2: Main compilation pass ---
ON ERROR GOTO PASS2_DONE
OPEN IN_FILE$ FOR INPUT AS FILE #1%
PASS2_LINE_LOOP:
LINE INPUT #1%, RAW_LINE$
IF RAW_LINE$ = "" THEN GOTO PASS2_LINE_LOOP

CONT_CHECK:
IF LEN(RAW_LINE$) > 0% AND MID$(RAW_LINE$, LEN(RAW_LINE$), 1%) = "&" THEN
  LET RAW_LINE$ = LEFT$(RAW_LINE$, LEN(RAW_LINE$) - 1%)
  LINE INPUT #1%, CONT_LINE$
  LET RAW_LINE$ = RAW_LINE$ + " " + CONT_LINE$
  GOTO CONT_CHECK
END IF

GOSUB STRIP_COMMENTS
IF RAW_LINE$ = "" THEN GOTO PASS2_LINE_LOOP

LET CUR_LINE$ = RAW_LINE$
GOSUB TRIM_CUR_LINE
IF CUR_LINE$ = "" THEN GOTO PASS2_LINE_LOOP
IF LEFT$(CUR_LINE$, 4%) = "REM " OR CUR_LINE$ = "REM" THEN GOTO PASS2_LINE_LOOP

! Check for line number or label definition
LET FIRST_CH$ = LEFT$(CUR_LINE$, 1%)
IF FIRST_CH$ >= "0" AND FIRST_CH$ <= "9" THEN
  LET SP_POS% = INSTR(1%, CUR_LINE$, " ")
  IF SP_POS% > 0% THEN
    LET LNUM_STR$ = LEFT$(CUR_LINE$, SP_POS% - 1%)
    LET NUM_LINES% = NUM_LINES% + 1%
    LET LINE_NUM%(NUM_LINES%) = VAL(LNUM_STR$)
    LET LINE_LBL$(NUM_LINES%) = ""
    LET LINE_OFF%(NUM_LINES%) = BC_LEN%
    LET CUR_LINE$ = MID$(CUR_LINE$, SP_POS% + 1%, LEN(CUR_LINE$) - SP_POS%)
  ELSE
    LET NUM_LINES% = NUM_LINES% + 1%
    LET LINE_NUM%(NUM_LINES%) = VAL(CUR_LINE$)
    LET LINE_LBL$(NUM_LINES%) = ""
    LET LINE_OFF%(NUM_LINES%) = BC_LEN%
    LET CUR_LINE$ = ""
  END IF
ELSE
  LET COLON_POS% = INSTR(1%, CUR_LINE$, ":")
  IF COLON_POS% > 0% AND INSTR(1%, LEFT$(CUR_LINE$, COLON_POS% - 1%), " ") = 0% THEN
    LET NUM_LINES% = NUM_LINES% + 1%
    LET LINE_NUM%(NUM_LINES%) = 0%
    LET LINE_LBL$(NUM_LINES%) = LEFT$(CUR_LINE$, COLON_POS% - 1%)
    LET LINE_OFF%(NUM_LINES%) = BC_LEN%
    IF COLON_POS% < LEN(CUR_LINE$) THEN
      LET CUR_LINE$ = MID$(CUR_LINE$, COLON_POS% + 1%, LEN(CUR_LINE$) - COLON_POS%)
    ELSE
      LET CUR_LINE$ = ""
    END IF
  END IF
END IF

PASS2_STMT_LOOP:
IF CUR_LINE$ = "" THEN GOTO PASS2_LINE_LOOP
GOSUB TRIM_CUR_LINE
IF CUR_LINE$ = "" THEN GOTO PASS2_LINE_LOOP
LET SEP_P% = 0%
LET IN_Q% = 0%
FOR P% = 1% TO LEN(CUR_LINE$)
  LET CH$ = MID$(CUR_LINE$, P%, 1%)
  IF CH$ = Q$ THEN LET IN_Q% = 1% - IN_Q%
  IF IN_Q% = 0% AND (CH$ = "\" OR CH$ = ":") AND SEP_P% = 0% THEN LET SEP_P% = P%
NEXT P%
IF SEP_P% > 0% THEN
  LET ONE_STMT$ = LEFT$(CUR_LINE$, SEP_P% - 1%)
  LET CUR_LINE$ = MID$(CUR_LINE$, SEP_P% + 1%, LEN(CUR_LINE$) - SEP_P%)
ELSE
  LET ONE_STMT$ = CUR_LINE$
  LET CUR_LINE$ = ""
END IF
LET SAVE_REST_LINE$ = CUR_LINE$
LET CUR_LINE$ = ONE_STMT$
GOSUB TRIM_CUR_LINE
IF CUR_LINE$ <> "" THEN GOSUB DISPATCH_STMT
LET CUR_LINE$ = SAVE_REST_LINE$
GOTO PASS2_STMT_LOOP

PASS2_DONE:
CLOSE #1%
ON ERROR GOTO 0

! Module termination
IF MOD_NAME$ = "MAIN" THEN
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
ELSE
  LET BC%(BC_LEN%) = 65%
  LET BC_LEN% = BC_LEN% + 1%
END IF

GOSUB RESOLVE_RELOCS
GOSUB WRITE_OUTPUT
END

! ==============================================================================
! Statement Dispatcher
! ==============================================================================
DISPATCH_STMT:
IF LEFT$(CUR_LINE$, 6%) = "PRINT " OR CUR_LINE$ = "PRINT" THEN GOTO STMT_PRINT
IF LEFT$(CUR_LINE$, 4%) = "LET " THEN GOTO STMT_LET
IF LEFT$(CUR_LINE$, 5%) = "GOTO " THEN GOTO STMT_GOTO
IF LEFT$(CUR_LINE$, 6%) = "GOSUB " THEN GOTO STMT_GOSUB
IF CUR_LINE$ = "RETURN" THEN GOTO STMT_RETURN
IF LEFT$(CUR_LINE$, 3%) = "IF " THEN GOTO STMT_IF
IF CUR_LINE$ = "ELSE" OR LEFT$(CUR_LINE$, 5%) = "ELSE " THEN GOTO STMT_ELSE
IF CUR_LINE$ = "END IF" THEN GOTO STMT_END_IF
IF LEFT$(CUR_LINE$, 4%) = "FOR " THEN GOTO STMT_FOR
IF LEFT$(CUR_LINE$, 5%) = "NEXT " OR CUR_LINE$ = "NEXT" THEN GOTO STMT_NEXT
IF LEFT$(CUR_LINE$, 6%) = "INPUT " OR LEFT$(CUR_LINE$, 11%) = "LINE INPUT " THEN GOTO STMT_INPUT
IF LEFT$(CUR_LINE$, 5%) = "CALL " THEN GOTO STMT_CALL
IF LEFT$(CUR_LINE$, 5%) = "OPEN " THEN GOTO STMT_OPEN
IF LEFT$(CUR_LINE$, 6%) = "CLOSE " OR CUR_LINE$ = "CLOSE" THEN GOTO STMT_CLOSE
IF LEFT$(CUR_LINE$, 4%) = "GET " THEN GOTO STMT_GET
IF LEFT$(CUR_LINE$, 4%) = "PUT " THEN GOTO STMT_PUT
IF LEFT$(CUR_LINE$, 8%) = "RESTORE " OR CUR_LINE$ = "RESTORE" THEN GOTO STMT_RESTORE
IF LEFT$(CUR_LINE$, 5%) = "READ " THEN GOTO STMT_READ
IF LEFT$(CUR_LINE$, 4%) = "DIM " THEN GOTO STMT_DIM
IF LEFT$(CUR_LINE$, 14%) = "ON ERROR GOTO " THEN GOTO STMT_ON_ERROR
IF LEFT$(CUR_LINE$, 7%) = "RESUME " OR CUR_LINE$ = "RESUME" THEN GOTO STMT_RESUME
IF LEFT$(CUR_LINE$, 4%) = "MAP " THEN GOTO STMT_MAP
IF CUR_LINE$ = "END" OR LEFT$(CUR_LINE$, 4%) = "END " THEN GOTO STMT_END
IF INSTR(1%, CUR_LINE$, "=") > 0% THEN GOTO STMT_LET
RETURN

! --- PRINT Statement ---
STMT_PRINT:
LET STMT$ = MID$(CUR_LINE$, 6%, LEN(CUR_LINE$) - 5%)
GOSUB TRIM_STMT
LET CH_NUM% = 0%
IF LEFT$(STMT$, 1%) = "#" THEN
  LET COMMA_P% = INSTR(1%, STMT$, ",")
  IF COMMA_P% = 0% THEN LET COMMA_P% = INSTR(1%, STMT$, ";")
  IF COMMA_P% > 0% THEN
    LET CH_STR$ = MID$(STMT$, 2%, COMMA_P% - 2%)
    LET CH_NUM% = VAL(CH_STR$)
    LET STMT$ = MID$(STMT$, COMMA_P% + 1%, LEN(STMT$) - COMMA_P%)
    GOSUB TRIM_STMT
  ELSE
    LET CH_NUM% = VAL(MID$(STMT$, 2%, LEN(STMT$) - 1%))
    LET STMT$ = ""
  END IF
END IF
IF STMT$ = "" THEN
  LET BC%(BC_LEN%) = 18%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 82%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = CH_NUM% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 1%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF LEFT$(STMT$, 6%) = "USING " THEN
  LET SEMI_P% = INSTR(1%, STMT$, ";")
  IF SEMI_P% > 0% THEN
    LET FMT_EXPR$ = MID$(STMT$, 7%, SEMI_P% - 7%)
    LET EXPR$ = FMT_EXPR$
    GOSUB EVAL_EXPR
    LET REST_ITEMS$ = MID$(STMT$, SEMI_P% + 1%, LEN(STMT$) - SEMI_P%)
    LET ITEM_CNT% = 0%
    GOSUB COMPILE_USING_ITEMS
    LET BC%(BC_LEN%) = 83%
    LET BC_LEN% = BC_LEN% + 1%
    LET BC%(BC_LEN%) = CH_NUM% AND 255%
    LET BC_LEN% = BC_LEN% + 1%
    LET BC%(BC_LEN%) = ITEM_CNT% AND 255%
    LET BC_LEN% = BC_LEN% + 1%
    RETURN
  END IF
END IF
LET HAS_NL% = 1%
IF MID$(STMT$, LEN(STMT$), 1%) = ";" OR MID$(STMT$, LEN(STMT$), 1%) = "," THEN
  LET HAS_NL% = 0%
  LET STMT$ = LEFT$(STMT$, LEN(STMT$) - 1%)
END IF
LET REST_ITEMS$ = STMT$
GOSUB COMPILE_PRINT_ITEMS
RETURN

! --- LET Statement ---
STMT_LET:
LET S$ = CUR_LINE$
IF LEFT$(S$, 4%) = "LET " THEN LET S$ = MID$(S$, 5%, LEN(S$) - 4%)
LET EQ_P% = INSTR(1%, S$, "=")
IF EQ_P% = 0% THEN RETURN
LET LHS$ = LEFT$(S$, EQ_P% - 1%)
LET RHS$ = MID$(S$, EQ_P% + 1%, LEN(S$) - EQ_P%)
LET EXPR$ = RHS$
GOSUB EVAL_EXPR
LET STMT$ = LHS$
GOSUB TRIM_STMT
LET LHS$ = STMT$
IF INSTR(1%, LHS$, "(") > 0% AND MID$(LHS$, LEN(LHS$), 1%) = ")" THEN
  LET P1% = INSTR(1%, LHS$, "(")
  LET VNAME$ = LEFT$(LHS$, P1% - 1%)
  GOSUB LOOKUP_VAR
  LET V_IDX% = VAR_IDX%
  LET EXPR$ = MID$(LHS$, P1% + 1%, LEN(LHS$) - P1% - 1%)
  GOSUB EVAL_EXPR
  LET BC%(BC_LEN%) = 22%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = V_IDX% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = INT(V_IDX% / 256%) AND 255%
  LET BC_LEN% = BC_LEN% + 1%
ELSE
  LET VNAME$ = LHS$
  GOSUB LOOKUP_VAR
  LET BC%(BC_LEN%) = 19%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = VAR_IDX% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = INT(VAR_IDX% / 256%) AND 255%
  LET BC_LEN% = BC_LEN% + 1%
END IF
RETURN

! --- GOTO Statement ---
STMT_GOTO:
LET TGT$ = MID$(CUR_LINE$, 6%, LEN(CUR_LINE$) - 5%)
GOSUB CLASSIFY_TARGET
LET BC%(BC_LEN%) = 48%
LET BC_LEN% = BC_LEN% + 1%
LET NUM_RELS% = NUM_RELS% + 1%
LET REL_OFF%(NUM_RELS%) = BC_LEN%
LET REL_TYPE$(NUM_RELS%) = "JMP"
IF TGT_IS_NUM% THEN
  LET REL_TGT_NUM%(NUM_RELS%) = TGT_NUM%
ELSE
  LET REL_TGT_NAME$(NUM_RELS%) = TGT_NAME$
END IF
LET BC%(BC_LEN%) = 0%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = 0%
LET BC_LEN% = BC_LEN% + 1%
RETURN

! --- GOSUB Statement ---
STMT_GOSUB:
LET TGT$ = MID$(CUR_LINE$, 7%, LEN(CUR_LINE$) - 6%)
GOSUB CLASSIFY_TARGET
LET BC%(BC_LEN%) = 64%
LET BC_LEN% = BC_LEN% + 1%
LET NUM_RELS% = NUM_RELS% + 1%
LET REL_OFF%(NUM_RELS%) = BC_LEN%
LET REL_TYPE$(NUM_RELS%) = "JMP"
IF TGT_IS_NUM% THEN
  LET REL_TGT_NUM%(NUM_RELS%) = TGT_NUM%
ELSE
  LET REL_TGT_NAME$(NUM_RELS%) = TGT_NAME$
END IF
LET BC%(BC_LEN%) = 0%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = 0%
LET BC_LEN% = BC_LEN% + 1%
RETURN

! --- RETURN Statement ---
STMT_RETURN:
LET BC%(BC_LEN%) = 65%
LET BC_LEN% = BC_LEN% + 1%
RETURN

! --- IF Statement ---
STMT_IF:
LET THEN_P% = INSTR(1%, CUR_LINE$, " THEN")
IF THEN_P% = 0% THEN RETURN
LET COND_EXPR$ = MID$(CUR_LINE$, 4%, THEN_P% - 4%)
LET EXPR$ = COND_EXPR$
GOSUB EVAL_EXPR
LET BC%(BC_LEN%) = 49%
LET BC_LEN% = BC_LEN% + 1%
LET JMP_LOC% = BC_LEN%
LET BC%(BC_LEN%) = 0%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = 0%
LET BC_LEN% = BC_LEN% + 1%
LET REST_IF$ = MID$(CUR_LINE$, THEN_P% + 5%, LEN(CUR_LINE$) - THEN_P% - 4%)
LET STMT$ = REST_IF$
GOSUB TRIM_STMT
LET REST_IF$ = STMT$
IF REST_IF$ = "" THEN
  LET IF_SP% = IF_SP% + 1%
  LET IF_JMP%(IF_SP%) = JMP_LOC%
  LET IF_TYPE$(IF_SP%) = "IF"
  RETURN
END IF
LET ELSE_P% = INSTR(1%, REST_IF$, " ELSE ")
IF ELSE_P% > 0% THEN
  LET THEN_ACTION$ = LEFT$(REST_IF$, ELSE_P% - 1%)
  LET ELSE_ACTION$ = MID$(REST_IF$, ELSE_P% + 6%, LEN(REST_IF$) - ELSE_P% - 5%)
ELSE
  LET THEN_ACTION$ = REST_IF$
  LET ELSE_ACTION$ = ""
END IF
LET ACTION$ = THEN_ACTION$
GOSUB COMPILE_ACTION
IF ELSE_ACTION$ <> "" THEN
  LET BC%(BC_LEN%) = 48%
  LET BC_LEN% = BC_LEN% + 1%
  LET END_LOC% = BC_LEN%
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(JMP_LOC%) = BC_LEN% AND 255%
  LET BC%(JMP_LOC% + 1%) = INT(BC_LEN% / 256%) AND 255%
  LET ACTION$ = ELSE_ACTION$
  GOSUB COMPILE_ACTION
  LET BC%(END_LOC%) = BC_LEN% AND 255%
  LET BC%(END_LOC% + 1%) = INT(BC_LEN% / 256%) AND 255%
ELSE
  LET BC%(JMP_LOC%) = BC_LEN% AND 255%
  LET BC%(JMP_LOC% + 1%) = INT(BC_LEN% / 256%) AND 255%
END IF
RETURN

! --- ELSE Statement (block) ---
STMT_ELSE:
IF IF_SP% < 1% THEN RETURN
LET PREV_JMP% = IF_JMP%(IF_SP%)
LET BC%(BC_LEN%) = 48%
LET BC_LEN% = BC_LEN% + 1%
LET END_LOC% = BC_LEN%
LET BC%(BC_LEN%) = 0%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = 0%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(PREV_JMP%) = BC_LEN% AND 255%
LET BC%(PREV_JMP% + 1%) = INT(BC_LEN% / 256%) AND 255%
LET IF_JMP%(IF_SP%) = END_LOC%
LET IF_TYPE$(IF_SP%) = "ELSE"
RETURN

! --- END IF Statement ---
STMT_END_IF:
IF IF_SP% < 1% THEN RETURN
LET PREV_JMP% = IF_JMP%(IF_SP%)
LET BC%(PREV_JMP%) = BC_LEN% AND 255%
LET BC%(PREV_JMP% + 1%) = INT(BC_LEN% / 256%) AND 255%
LET IF_SP% = IF_SP% - 1%
RETURN

! --- FOR Statement ---
STMT_FOR:
LET S$ = MID$(CUR_LINE$, 5%, LEN(CUR_LINE$) - 4%)
LET EQ_P% = INSTR(1%, S$, "=")
LET TO_P% = INSTR(1%, S$, " TO ")
IF EQ_P% = 0% OR TO_P% = 0% THEN RETURN
LET FVAR$ = LEFT$(S$, EQ_P% - 1%)
LET FROM_E$ = MID$(S$, EQ_P% + 1%, TO_P% - EQ_P% - 1%)
LET REST_FOR$ = MID$(S$, TO_P% + 4%, LEN(S$) - TO_P% - 3%)
LET STEP_P% = INSTR(1%, REST_FOR$, " STEP ")
IF STEP_P% > 0% THEN
  LET TO_E$ = LEFT$(REST_FOR$, STEP_P% - 1%)
  LET STEP_E$ = MID$(REST_FOR$, STEP_P% + 6%, LEN(REST_FOR$) - STEP_P% - 5%)
ELSE
  LET TO_E$ = REST_FOR$
  LET STEP_E$ = "1"
END IF
LET EXPR$ = FROM_E$
GOSUB EVAL_EXPR
LET VNAME$ = FVAR$
GOSUB LOOKUP_VAR
LET BC%(BC_LEN%) = 19%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = VAR_IDX% AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = INT(VAR_IDX% / 256%) AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET LOOP_START% = BC_LEN%
LET BC%(BC_LEN%) = 20%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = VAR_IDX% AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = INT(VAR_IDX% / 256%) AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET EXPR$ = TO_E$
GOSUB EVAL_EXPR
LET BC%(BC_LEN%) = 39%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = 16%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = 0%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = 0%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = 36%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = 49%
LET BC_LEN% = BC_LEN% + 1%
LET EXIT_JMP% = BC_LEN%
LET BC%(BC_LEN%) = 0%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = 0%
LET BC_LEN% = BC_LEN% + 1%
LET FOR_SP% = FOR_SP% + 1%
LET FOR_VAR%(FOR_SP%) = VAR_IDX%
LET FOR_START%(FOR_SP%) = LOOP_START%
LET FOR_JMP%(FOR_SP%) = EXIT_JMP%
LET FOR_STEP%(FOR_SP%) = VAL(STEP_E$)
RETURN

! --- NEXT Statement ---
STMT_NEXT:
IF FOR_SP% < 1% THEN RETURN
LET V_IDX% = FOR_VAR%(FOR_SP%)
LET L_START% = FOR_START%(FOR_SP%)
LET E_JMP% = FOR_JMP%(FOR_SP%)
LET ST_VAL% = FOR_STEP%(FOR_SP%)
LET BC%(BC_LEN%) = 20%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = V_IDX% AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = INT(V_IDX% / 256%) AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = 16%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = ST_VAL% AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = INT(ST_VAL% / 256%) AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = 32%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = 19%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = V_IDX% AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = INT(V_IDX% / 256%) AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = 48%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = L_START% AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = INT(L_START% / 256%) AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(E_JMP%) = BC_LEN% AND 255%
LET BC%(E_JMP% + 1%) = INT(BC_LEN% / 256%) AND 255%
LET FOR_SP% = FOR_SP% - 1%
RETURN

! --- INPUT Statement ---
STMT_INPUT:
LET S$ = CUR_LINE$
IF LEFT$(S$, 11%) = "LINE INPUT " THEN LET S$ = MID$(S$, 12%, LEN(S$) - 11%)
IF LEFT$(S$, 6%) = "INPUT " THEN LET S$ = MID$(S$, 7%, LEN(S$) - 6%)
IF LEFT$(S$, 1%) = "#" THEN
  LET COMMA_P% = INSTR(1%, S$, ",")
  LET CH_STR$ = MID$(S$, 2%, COMMA_P% - 2%)
  LET CH% = VAL(CH_STR$)
  LET VNAME$ = MID$(S$, COMMA_P% + 1%, LEN(S$) - COMMA_P%)
  LET STMT$ = VNAME$
  GOSUB TRIM_STMT
  LET VNAME$ = STMT$
  GOSUB LOOKUP_VAR
  LET BC%(BC_LEN%) = 123%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = CH% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = VAR_IDX% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = INT(VAR_IDX% / 256%) AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF LEFT$(S$, 1%) = Q$ THEN
  LET Q2% = INSTR(2%, S$, Q$)
  LET PR_STR$ = MID$(S$, 2%, Q2% - 2%)
  LET BC%(BC_LEN%) = 18%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = LEN(PR_STR$) AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  FOR K% = 1% TO LEN(PR_STR$)
    LET BC%(BC_LEN%) = ASCII(MID$(PR_STR$, K%, 1%))
    LET BC_LEN% = BC_LEN% + 1%
  NEXT K%
  LET BC%(BC_LEN%) = 81%
  LET BC_LEN% = BC_LEN% + 1%
  LET S$ = MID$(S$, Q2% + 2%, LEN(S$) - Q2% - 1%)
  LET STMT$ = S$
  GOSUB TRIM_STMT
  LET S$ = STMT$
END IF
LET VNAME$ = S$
GOSUB LOOKUP_VAR
IF MID$(VNAME$, LEN(VNAME$), 1%) = "$" THEN
  LET BC%(BC_LEN%) = 113%
  LET BC_LEN% = BC_LEN% + 1%
ELSE
  LET BC%(BC_LEN%) = 112%
  LET BC_LEN% = BC_LEN% + 1%
END IF
LET BC%(BC_LEN%) = VAR_IDX% AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = INT(VAR_IDX% / 256%) AND 255%
LET BC_LEN% = BC_LEN% + 1%
RETURN

! --- CALL Statement ---
STMT_CALL:
LET MOD_TARGET$ = MID$(CUR_LINE$, 6%, LEN(CUR_LINE$) - 5%)
IF LEFT$(MOD_TARGET$, 1%) = Q$ THEN LET MOD_TARGET$ = MID$(MOD_TARGET$, 2%, LEN(MOD_TARGET$) - 2%)
LET BC%(BC_LEN%) = 66%
LET BC_LEN% = BC_LEN% + 1%
LET NUM_RELS% = NUM_RELS% + 1%
LET REL_OFF%(NUM_RELS%) = BC_LEN%
LET REL_TYPE$(NUM_RELS%) = "CALL_OVL"
LET REL_TGT_NAME$(NUM_RELS%) = MOD_TARGET$
LET BC%(BC_LEN%) = 0%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = 0%
LET BC_LEN% = BC_LEN% + 1%
RETURN

! --- OPEN Statement ---
STMT_OPEN:
LET S$ = MID$(CUR_LINE$, 6%, LEN(CUR_LINE$) - 5%)
LET AS_P% = INSTR(1%, S$, " AS FILE ")
IF AS_P% = 0% THEN LET AS_P% = INSTR(1%, S$, " AS ")
IF AS_P% = 0% THEN RETURN
LET PRE_AS$ = LEFT$(S$, AS_P% - 1%)
LET POST_AS$ = MID$(S$, AS_P%, LEN(S$) - AS_P% + 1%)
LET OPEN_MODE% = 0%
IF INSTR(1%, PRE_AS$, " FOR OUTPUT") > 0% THEN
  LET OPEN_MODE% = 1%
  LET P% = INSTR(1%, PRE_AS$, " FOR OUTPUT")
  LET FNAME_EXPR$ = LEFT$(PRE_AS$, P% - 1%)
ELSE
  IF INSTR(1%, PRE_AS$, " FOR INPUT") > 0% THEN
    LET OPEN_MODE% = 0%
    LET P% = INSTR(1%, PRE_AS$, " FOR INPUT")
    LET FNAME_EXPR$ = LEFT$(PRE_AS$, P% - 1%)
  ELSE
    LET FNAME_EXPR$ = PRE_AS$
  END IF
END IF
IF INSTR(1%, POST_AS$, "INDEXED") > 0% THEN
  IF OPEN_MODE% = 1% THEN
    LET OPEN_MODE% = 3%
  ELSE
    LET OPEN_MODE% = 2%
  END IF
END IF
LET EXPR$ = FNAME_EXPR$
GOSUB EVAL_EXPR
LET HASH_P% = INSTR(1%, POST_AS$, "#")
LET CH_STR$ = MID$(POST_AS$, HASH_P% + 1%, 2%)
LET CH% = VAL(CH_STR$)
LET PK_IDX% = 0%
IF INSTR(1%, POST_AS$, "PRIMARY KEY") > 0% THEN
  LET P% = INSTR(1%, POST_AS$, "PRIMARY KEY") + 12%
  LET RMN_P$ = MID$(POST_AS$, P%, LEN(POST_AS$) - P% + 1%)
  LET COMMA_P% = INSTR(1%, RMN_P$, ",")
  IF COMMA_P% > 0% THEN LET PK_VAR$ = LEFT$(RMN_P$, COMMA_P% - 1%) ELSE LET PK_VAR$ = RMN_P$
  LET VNAME$ = PK_VAR$
  GOSUB LOOKUP_VAR
  LET PK_IDX% = VAR_IDX%
END IF
LET MAP_FOUND% = 0%
IF INSTR(1%, POST_AS$, "MAP ") > 0% THEN
  LET P% = INSTR(1%, POST_AS$, "MAP ") + 4%
  LET RMN_M$ = MID$(POST_AS$, P%, LEN(POST_AS$) - P% + 1%)
  LET COMMA_P% = INSTR(1%, RMN_M$, ",")
  IF COMMA_P% > 0% THEN LET M_NAME$ = LEFT$(RMN_M$, COMMA_P% - 1%) ELSE LET M_NAME$ = RMN_M$
  FOR M% = 1% TO NUM_MAPS%
    IF MAP_NAME$(M%) = M_NAME$ THEN LET MAP_FOUND% = M%
  NEXT M%
END IF
LET BC%(BC_LEN%) = 96%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = CH% AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = OPEN_MODE% AND 255%
LET BC_LEN% = BC_LEN% + 1%
IF OPEN_MODE% = 2% OR OPEN_MODE% = 3% THEN
  LET BC%(BC_LEN%) = PK_IDX% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = INT(PK_IDX% / 256%) AND 255%
  LET BC_LEN% = BC_LEN% + 1%
END IF
IF MAP_FOUND% > 0% THEN
  LET MCNT% = MAP_VAR_CNT%(MAP_FOUND%)
  LET BC%(BC_LEN%) = MCNT% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  FOR K% = 1% TO MCNT%
    LET VNAME$ = MAP_VARS$(MAP_FOUND%, K%)
    GOSUB LOOKUP_VAR
    LET BC%(BC_LEN%) = VAR_IDX% AND 255%
    LET BC_LEN% = BC_LEN% + 1%
    LET BC%(BC_LEN%) = INT(VAR_IDX% / 256%) AND 255%
    LET BC_LEN% = BC_LEN% + 1%
  NEXT K%
ELSE
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
END IF
RETURN

! --- CLOSE Statement ---
STMT_CLOSE:
LET S$ = MID$(CUR_LINE$, 7%, LEN(CUR_LINE$) - 6%)
IF S$ = "" THEN
  LET BC%(BC_LEN%) = 99%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
GOSUB EXTRACT_CHANNELS
RETURN

! --- GET Statement ---
STMT_GET:
LET S$ = MID$(CUR_LINE$, 5%, LEN(CUR_LINE$) - 4%)
LET HASH_P% = INSTR(1%, S$, "#")
LET CH% = VAL(MID$(S$, HASH_P% + 1%, 2%))
LET KEY_P% = INSTR(1%, S$, "KEY ")
IF KEY_P% > 0% THEN
  LET KEY_VAR$ = MID$(S$, KEY_P% + 4%, LEN(S$) - KEY_P% - 3%)
  LET VNAME$ = KEY_VAR$
  GOSUB LOOKUP_VAR
  LET BC%(BC_LEN%) = 97%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = CH% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 1%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = VAR_IDX% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = INT(VAR_IDX% / 256%) AND 255%
  LET BC_LEN% = BC_LEN% + 1%
ELSE
  LET BC%(BC_LEN%) = 97%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = CH% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
END IF
RETURN

! --- PUT Statement ---
STMT_PUT:
LET S$ = MID$(CUR_LINE$, 5%, LEN(CUR_LINE$) - 4%)
LET HASH_P% = INSTR(1%, S$, "#")
LET CH% = VAL(MID$(S$, HASH_P% + 1%, 2%))
LET BC%(BC_LEN%) = 98%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = CH% AND 255%
LET BC_LEN% = BC_LEN% + 1%
RETURN

! --- RESTORE Statement ---
STMT_RESTORE:
LET S$ = CUR_LINE$
LET CH% = 0%
LET KID% = 0%
IF INSTR(1%, S$, "#") > 0% THEN
  LET HASH_P% = INSTR(1%, S$, "#")
  LET CH% = VAL(MID$(S$, HASH_P% + 1%, 2%))
END IF
LET BC%(BC_LEN%) = 100%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = CH% AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = KID% AND 255%
LET BC_LEN% = BC_LEN% + 1%
RETURN

! --- READ Statement ---
STMT_READ:
LET S$ = MID$(CUR_LINE$, 6%, LEN(CUR_LINE$) - 5%)
GOSUB PARSE_READ_ITEMS
RETURN

! --- DIM Statement ---
STMT_DIM:
LET S$ = MID$(CUR_LINE$, 5%, LEN(CUR_LINE$) - 4%)
LET P1% = INSTR(1%, S$, "(")
LET P2% = INSTR(P1%, S$, ")")
IF P1% > 0% AND P2% > 0% THEN
  LET VNAME$ = LEFT$(S$, P1% - 1%)
  GOSUB LOOKUP_VAR
  LET V_IDX% = VAR_IDX%
  LET EXPR$ = MID$(S$, P1% + 1%, P2% - P1% - 1%)
  GOSUB EVAL_EXPR
  LET BC%(BC_LEN%) = 21%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = V_IDX% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = INT(V_IDX% / 256%) AND 255%
  LET BC_LEN% = BC_LEN% + 1%
END IF
RETURN

! --- ON ERROR GOTO Statement ---
STMT_ON_ERROR:
LET TGT$ = MID$(CUR_LINE$, 15%, LEN(CUR_LINE$) - 14%)
GOSUB CLASSIFY_TARGET
LET BC%(BC_LEN%) = 120%
LET BC_LEN% = BC_LEN% + 1%
IF TGT_IS_NUM% AND TGT_NUM% = 0% THEN
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
ELSE
  LET VNAME$ = "ERR"
  GOSUB LOOKUP_VAR
  LET ERR_VAR_IDX% = VAR_IDX%
  LET NUM_RELS% = NUM_RELS% + 1%
  LET REL_OFF%(NUM_RELS%) = BC_LEN%
  LET REL_TYPE$(NUM_RELS%) = "ON_ERROR"
  IF TGT_IS_NUM% THEN
    LET REL_TGT_NUM%(NUM_RELS%) = TGT_NUM%
  ELSE
    LET REL_TGT_NAME$(NUM_RELS%) = TGT_NAME$
  END IF
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = ERR_VAR_IDX% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = INT(ERR_VAR_IDX% / 256%) AND 255%
  LET BC_LEN% = BC_LEN% + 1%
END IF
RETURN

! --- RESUME Statement ---
STMT_RESUME:
LET S$ = MID$(CUR_LINE$, 8%, LEN(CUR_LINE$) - 7%)
LET BC%(BC_LEN%) = 121%
LET BC_LEN% = BC_LEN% + 1%
IF S$ <> "" THEN
  LET TGT$ = S$
  GOSUB CLASSIFY_TARGET
  LET NUM_RELS% = NUM_RELS% + 1%
  LET REL_OFF%(NUM_RELS%) = BC_LEN%
  LET REL_TYPE$(NUM_RELS%) = "RESUME"
  IF TGT_IS_NUM% THEN
    LET REL_TGT_NUM%(NUM_RELS%) = TGT_NUM%
  ELSE
    LET REL_TGT_NAME$(NUM_RELS%) = TGT_NAME$
  END IF
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
ELSE
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
END IF
RETURN

! --- MAP Statement ---
STMT_MAP:
LET P1% = INSTR(1%, CUR_LINE$, "(")
LET P2% = INSTR(P1%, CUR_LINE$, ")")
IF P1% > 0% AND P2% > 0% THEN
  LET NUM_MAPS% = NUM_MAPS% + 1%
  LET MAP_NAME$(NUM_MAPS%) = MID$(CUR_LINE$, P1% + 1%, P2% - P1% - 1%)
  LET VARS_STR$ = MID$(CUR_LINE$, P2% + 1%, LEN(CUR_LINE$) - P2%)
  GOSUB PARSE_MAP_ITEMS
