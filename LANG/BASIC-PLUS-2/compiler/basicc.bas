  END IF
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
ELSE
  LET CUR_LINE$ = ACTION$
