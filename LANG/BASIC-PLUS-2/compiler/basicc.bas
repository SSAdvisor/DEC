! Compile USING print items
COMPILE_USING_ITEMS:
LET CP% = 1%
USING_ITEM_LOOP:
IF CP% > LEN(REST_ITEMS$) THEN RETURN
LET COMMA_P% = INSTR(CP%, REST_ITEMS$, ",")
IF COMMA_P% > 0% THEN
  LET EXPR$ = MID$(REST_ITEMS$, CP%, COMMA_P% - CP%)
  LET CP% = COMMA_P% + 1%
ELSE
  LET EXPR$ = MID$(REST_ITEMS$, CP%, LEN(REST_ITEMS$) - CP% + 1%)
  LET CP% = LEN(REST_ITEMS$) + 1%
END IF
GOSUB EVAL_EXPR
LET ITEM_CNT% = ITEM_CNT% + 1%
GOTO USING_ITEM_LOOP

! Compile standard print items with OP_PRINT_CH
COMPILE_PRINT_ITEMS:
LET CP% = 1%
PRINT_ITEM_LOOP:
IF CP% > LEN(REST_ITEMS$) THEN RETURN
LET IN_Q% = 0%
LET D_POS% = 0%
FOR P% = CP% TO LEN(REST_ITEMS$)
  LET CH$ = MID$(REST_ITEMS$, P%, 1%)
  IF CH$ = Q$ THEN LET IN_Q% = 1% - IN_Q%
  IF IN_Q% = 0% AND (CH$ = "," OR CH$ = ";") AND D_POS% = 0% THEN LET D_POS% = P%
NEXT P%
IF D_POS% > 0% THEN
  LET EXPR$ = MID$(REST_ITEMS$, CP%, D_POS% - CP%)
  LET CP% = D_POS% + 1%
  LET NL% = 0%
ELSE
  LET EXPR$ = MID$(REST_ITEMS$, CP%, LEN(REST_ITEMS$) - CP% + 1%)
  LET CP% = LEN(REST_ITEMS$) + 1%
  LET NL% = HAS_NL%
END IF
IF EXPR$ <> "" THEN
  GOSUB EVAL_EXPR
  LET BC%(BC_LEN%) = 82%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = CH_NUM% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = NL% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
END IF
GOTO PRINT_ITEM_LOOP

! Variable Table Lookup (VNAME$ -> VAR_IDX%)
LOOKUP_VAR:
LOOKUP_VAR_TRIM:
IF VNAME$ = "" THEN
  LET VAR_IDX% = 0%
  RETURN
END IF
IF LEFT$(VNAME$, 1%) = " " THEN
  LET VNAME$ = MID$(VNAME$, 2%, LEN(VNAME$) - 1%)
  GOTO LOOKUP_VAR_TRIM
END IF
IF MID$(VNAME$, LEN(VNAME$), 1%) = " " THEN
  LET VNAME$ = LEFT$(VNAME$, LEN(VNAME$) - 1%)
  GOTO LOOKUP_VAR_TRIM
END IF
FOR V% = 1% TO NUM_VARS%
  IF VAR_NAME$(V%) = VNAME$ THEN
    LET VAR_IDX% = V% - 1%
    RETURN
  END IF
NEXT V%
LET NUM_VARS% = NUM_VARS% + 1%
LET VAR_NAME$(NUM_VARS%) = VNAME$
LET VAR_IDX% = NUM_VARS% - 1%
RETURN

! DATA Parser
PARSE_DATA_ITEMS:
LET DP% = 1%
DATA_ITEM_LOOP:
IF DP% > LEN(REST_DATA$) THEN RETURN
LET COMMA_P% = INSTR(DP%, REST_DATA$, ",")
IF COMMA_P% > 0% THEN
  LET DITEM$ = MID$(REST_DATA$, DP%, COMMA_P% - DP%)
  LET DP% = COMMA_P% + 1%
ELSE
  LET DITEM$ = MID$(REST_DATA$, DP%, LEN(REST_DATA$) - DP% + 1%)
  LET DP% = LEN(REST_DATA$) + 1%
END IF
DATA_ITEM_TRIM:
IF DITEM$ = "" THEN GOTO DATA_ITEM_LOOP
IF LEFT$(DITEM$, 1%) = " " THEN
  LET DITEM$ = MID$(DITEM$, 2%, LEN(DITEM$) - 1%)
  GOTO DATA_ITEM_TRIM
END IF
IF MID$(DITEM$, LEN(DITEM$), 1%) = " " THEN
  LET DITEM$ = LEFT$(DITEM$, LEN(DITEM$) - 1%)
  GOTO DATA_ITEM_TRIM
END IF
LET NUM_DATA% = NUM_DATA% + 1%
IF LEFT$(DITEM$, 1%) = Q$ THEN
  LET DATA_TYPE%(NUM_DATA%) = 2%
  LET DATA_STR$(NUM_DATA%) = MID$(DITEM$, 2%, LEN(DITEM$) - 2%)
ELSE
  LET DATA_TYPE%(NUM_DATA%) = 0%
  LET DATA_INT%(NUM_DATA%) = VAL(DITEM$)
END IF
GOTO DATA_ITEM_LOOP

! READ Parser
PARSE_READ_ITEMS:
LET RP% = 1%
READ_ITEM_LOOP:
IF RP% > LEN(S$) THEN RETURN
LET COMMA_P% = INSTR(RP%, S$, ",")
IF COMMA_P% > 0% THEN
  LET RVAR$ = MID$(S$, RP%, COMMA_P% - RP%)
  LET RP% = COMMA_P% + 1%
ELSE
  LET RVAR$ = MID$(S$, RP%, LEN(S$) - RP% + 1%)
  LET RP% = LEN(S$) + 1%
END IF
LET VNAME$ = RVAR$
GOSUB LOOKUP_VAR
LET BC%(BC_LEN%) = 119%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = VAR_IDX% AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = INT(VAR_IDX% / 256%) AND 255%
LET BC_LEN% = BC_LEN% + 1%
GOTO READ_ITEM_LOOP

! MAP Items Parser
PARSE_MAP_ITEMS:
LET MP% = 1%
MAP_ITEM_LOOP:
IF MP% > LEN(VARS_STR$) THEN RETURN
LET COMMA_P% = INSTR(MP%, VARS_STR$, ",")
IF COMMA_P% > 0% THEN
  LET MITEM$ = MID$(VARS_STR$, MP%, COMMA_P% - MP%)
  LET MP% = COMMA_P% + 1%
ELSE
  LET MITEM$ = MID$(VARS_STR$, MP%, LEN(VARS_STR$) - MP% + 1%)
  LET MP% = LEN(VARS_STR$) + 1%
END IF
MAP_ITEM_TRIM1:
IF MITEM$ = "" THEN GOTO MAP_ITEM_LOOP
IF LEFT$(MITEM$, 1%) = " " THEN
  LET MITEM$ = MID$(MITEM$, 2%, LEN(MITEM$) - 1%)
  GOTO MAP_ITEM_TRIM1
END IF
LET SP_P% = INSTR(1%, MITEM$, " ")
IF SP_P% > 0% THEN LET MITEM$ = MID$(MITEM$, SP_P% + 1%, LEN(MITEM$) - SP_P%)
LET EQ_P% = INSTR(1%, MITEM$, "=")
IF EQ_P% > 0% THEN LET MITEM$ = LEFT$(MITEM$, EQ_P% - 1%)
MAP_ITEM_TRIM2:
IF MITEM$ = "" THEN GOTO MAP_ITEM_LOOP
IF LEFT$(MITEM$, 1%) = " " THEN
  LET MITEM$ = MID$(MITEM$, 2%, LEN(MITEM$) - 1%)
  GOTO MAP_ITEM_TRIM2
END IF
IF MID$(MITEM$, LEN(MITEM$), 1%) = " " THEN
  LET MITEM$ = LEFT$(MITEM$, LEN(MITEM$) - 1%)
  GOTO MAP_ITEM_TRIM2
END IF
LET CNT% = MAP_VAR_CNT%(NUM_MAPS%) + 1%
LET MAP_VAR_CNT%(NUM_MAPS%) = CNT%
LET MAP_VARS$(NUM_MAPS%, CNT%) = MITEM$
GOTO MAP_ITEM_LOOP

! Trim string in STMT$
TRIM_STMT:
TRIM_STMT_LOOP:
IF STMT$ = "" THEN RETURN
IF LEFT$(STMT$, 1%) = " " THEN
  LET STMT$ = MID$(STMT$, 2%, LEN(STMT$) - 1%)
  GOTO TRIM_STMT_LOOP
END IF
IF MID$(STMT$, LEN(STMT$), 1%) = " " THEN
  LET STMT$ = LEFT$(STMT$, LEN(STMT$) - 1%)
  GOTO TRIM_STMT_LOOP
END IF
RETURN

! Trim string in CUR_LINE$
TRIM_CUR_LINE:
TRIM_CUR_LINE_LOOP:
IF CUR_LINE$ = "" THEN RETURN
IF LEFT$(CUR_LINE$, 1%) = " " THEN
  LET CUR_LINE$ = MID$(CUR_LINE$, 2%, LEN(CUR_LINE$) - 1%)
  GOTO TRIM_CUR_LINE_LOOP
END IF
IF MID$(CUR_LINE$, LEN(CUR_LINE$), 1%) = " " THEN
  LET CUR_LINE$ = LEFT$(CUR_LINE$, LEN(CUR_LINE$) - 1%)
  GOTO TRIM_CUR_LINE_LOOP
END IF
RETURN

! Strip comments from RAW_LINE$ outside quotes
STRIP_COMMENTS:
LET IN_Q% = 0%
FOR P% = 1% TO LEN(RAW_LINE$)
  LET CH$ = MID$(RAW_LINE$, P%, 1%)
  IF CH$ = Q$ THEN LET IN_Q% = 1% - IN_Q%
  IF IN_Q% = 0% AND CH$ = "!" THEN
    LET RAW_LINE$ = LEFT$(RAW_LINE$, P% - 1%)
    RETURN
  END IF
NEXT P%
RETURN

! Target Classifier (number or label name in TGT$)
CLASSIFY_TARGET:
CLASSIFY_TARGET_TRIM:
IF TGT$ = "" THEN
  LET TGT_IS_NUM% = 0%
  LET TGT_NUM% = 0%
  LET TGT_NAME$ = ""
  RETURN
END IF
IF LEFT$(TGT$, 1%) = " " THEN
  LET TGT$ = MID$(TGT$, 2%, LEN(TGT$) - 1%)
  GOTO CLASSIFY_TARGET_TRIM
END IF
IF MID$(TGT$, LEN(TGT$), 1%) = " " THEN
  LET TGT$ = LEFT$(TGT$, LEN(TGT$) - 1%)
  GOTO CLASSIFY_TARGET_TRIM
END IF
IF LEFT$(TGT$, 1%) >= "0" AND LEFT$(TGT$, 1%) <= "9" THEN
  LET TGT_IS_NUM% = 1%
  LET TGT_NUM% = VAL(TGT$)
  LET TGT_NAME$ = ""
ELSE
  LET TGT_IS_NUM% = 0%
  LET TGT_NUM% = 0%
  LET TGT_NAME$ = TGT$
END IF
RETURN

! Check if ACTION$ is a jump target
CHECK_TARGET:
LET TGT$ = ACTION$
GOSUB CLASSIFY_TARGET
IF TGT_IS_NUM% THEN
  LET IS_TGT% = 1%
  RETURN
END IF
IF INSTR(1%, ACTION$, " ") = 0% AND INSTR(1%, ACTION$, "=") = 0% AND INSTR(1%, ACTION$, "(") = 0% THEN
  LET IS_TGT% = 1%
  RETURN
END IF
LET IS_TGT% = 0%
RETURN

! Extract channels from S$ and emit OP_RMS_CLOS
EXTRACT_CHANNELS:
LET CP% = 1%
EXTRACT_CH_LOOP:
IF CP% > LEN(S$) THEN RETURN
LET HASH_P% = INSTR(CP%, S$, "#")
IF HASH_P% = 0% THEN RETURN
LET CH_VAL% = VAL(MID$(S$, HASH_P% + 1%, 2%))
LET BC%(BC_LEN%) = 99%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = CH_VAL% AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET COMMA_P% = INSTR(HASH_P%, S$, ",")
IF COMMA_P% > 0% THEN
  LET CP% = COMMA_P% + 1%
  GOTO EXTRACT_CH_LOOP
END IF
RETURN

! Expression Evaluator (EXPR$ -> bytecode)
EVAL_EXPR:
TRIM_EXPR_LOOP:
IF EXPR$ = "" THEN RETURN
IF LEFT$(EXPR$, 1%) = " " THEN
  LET EXPR$ = MID$(EXPR$, 2%, LEN(EXPR$) - 1%)
  GOTO TRIM_EXPR_LOOP
END IF
IF MID$(EXPR$, LEN(EXPR$), 1%) = " " THEN
  LET EXPR$ = LEFT$(EXPR$, LEN(EXPR$) - 1%)
  GOTO TRIM_EXPR_LOOP
END IF
IF EXPR$ = "" THEN RETURN

! 1. Check for single string literal
IF LEFT$(EXPR$, 1%) = Q$ AND MID$(EXPR$, LEN(EXPR$), 1%) = Q$ THEN
  LET LIT$ = MID$(EXPR$, 2%, LEN(EXPR$) - 2%)
  LET BC%(BC_LEN%) = 18%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = LEN(LIT$) AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  FOR K% = 1% TO LEN(LIT$)
    LET BC%(BC_LEN%) = ASCII(MID$(LIT$, K%, 1%))
    LET BC_LEN% = BC_LEN% + 1%
  NEXT K%
  RETURN
END IF

! 2. Check for single integer literal
IF LEFT$(EXPR$, 1%) >= "0" AND LEFT$(EXPR$, 1%) <= "9" AND INSTR(1%, EXPR$, " ") = 0% AND INSTR(1%, EXPR$, "+") = 0% AND INSTR(1%, EXPR$, "*") = 0% AND INSTR(1%, EXPR$, "/") = 0% AND INSTR(1%, EXPR$, "-") = 0% THEN
  LET IV% = VAL(EXPR$)
  LET BC%(BC_LEN%) = 16%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = IV% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = INT(IV% / 256%) AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF

! 3. Binary operator scan
LET FOUND_OP$ = ""
LET FOUND_P% = 0%
IF INSTR(1%, EXPR$, " OR ") > 0% THEN
  LET FOUND_OP$ = "OR"
  LET FOUND_P% = INSTR(1%, EXPR$, " OR ")
  GOTO BIN_OP_SPLIT
END IF
IF INSTR(1%, EXPR$, " AND ") > 0% THEN
  LET FOUND_OP$ = "AND"
  LET FOUND_P% = INSTR(1%, EXPR$, " AND ")
  GOTO BIN_OP_SPLIT
END IF
IF INSTR(1%, EXPR$, " = ") > 0% THEN
  LET FOUND_OP$ = "="
  LET FOUND_P% = INSTR(1%, EXPR$, " = ")
  GOTO BIN_OP_SPLIT
END IF
IF INSTR(1%, EXPR$, " <> ") > 0% THEN
  LET FOUND_OP$ = "<>"
  LET FOUND_P% = INSTR(1%, EXPR$, " <> ")
  GOTO BIN_OP_SPLIT
END IF
IF INSTR(1%, EXPR$, " <= ") > 0% THEN
  LET FOUND_OP$ = "<="
  LET FOUND_P% = INSTR(1%, EXPR$, " <= ")
  GOTO BIN_OP_SPLIT
END IF
IF INSTR(1%, EXPR$, " >= ") > 0% THEN
  LET FOUND_OP$ = ">="
  LET FOUND_P% = INSTR(1%, EXPR$, " >= ")
  GOTO BIN_OP_SPLIT
END IF
IF INSTR(1%, EXPR$, " < ") > 0% THEN
  LET FOUND_OP$ = "<"
  LET FOUND_P% = INSTR(1%, EXPR$, " < ")
  GOTO BIN_OP_SPLIT
END IF
IF INSTR(1%, EXPR$, " > ") > 0% THEN
  LET FOUND_OP$ = ">"
  LET FOUND_P% = INSTR(1%, EXPR$, " > ")
  GOTO BIN_OP_SPLIT
END IF

! Additive (+, -)
LET IN_Q% = 0%
LET IN_P% = 0%
LET SCAN_P% = LEN(EXPR$)
SCAN_ADD_LOOP:
IF SCAN_P% < 1% THEN GOTO SCAN_ADD_DONE
LET CH$ = MID$(EXPR$, SCAN_P%, 1%)
IF CH$ = Q$ THEN LET IN_Q% = 1% - IN_Q%
IF CH$ = ")" THEN LET IN_P% = IN_P% + 1%
IF CH$ = "(" THEN LET IN_P% = IN_P% - 1%
IF IN_Q% = 0% AND IN_P% = 0% AND FOUND_P% = 0% THEN
  IF CH$ = "+" THEN
    LET FOUND_OP$ = "+"
    LET FOUND_P% = SCAN_P%
  END IF
  IF CH$ = "-" AND SCAN_P% > 1% THEN
    LET FOUND_OP$ = "-"
    LET FOUND_P% = SCAN_P%
  END IF
END IF
LET SCAN_P% = SCAN_P% - 1%
GOTO SCAN_ADD_LOOP
SCAN_ADD_DONE:

IF FOUND_P% = 0% THEN
  LET SCAN_P% = LEN(EXPR$)
SCAN_MUL_LOOP:
  IF SCAN_P% < 1% THEN GOTO SCAN_MUL_DONE
  LET CH$ = MID$(EXPR$, SCAN_P%, 1%)
  IF CH$ = Q$ THEN LET IN_Q% = 1% - IN_Q%
  IF CH$ = ")" THEN LET IN_P% = IN_P% + 1%
  IF CH$ = "(" THEN LET IN_P% = IN_P% - 1%
  IF IN_Q% = 0% AND IN_P% = 0% AND FOUND_P% = 0% THEN
    IF CH$ = "*" THEN
      LET FOUND_OP$ = "*"
      LET FOUND_P% = SCAN_P%
    END IF
    IF CH$ = "/" THEN
      LET FOUND_OP$ = "/"
      LET FOUND_P% = SCAN_P%
    END IF
  END IF
  LET SCAN_P% = SCAN_P% - 1%
  GOTO SCAN_MUL_LOOP
SCAN_MUL_DONE:
END IF

BIN_OP_SPLIT:
IF FOUND_P% > 0% THEN
  LET L_EXP$ = LEFT$(EXPR$, FOUND_P% - 1%)
  IF FOUND_OP$ = "OR" OR FOUND_OP$ = "AND" THEN
    LET R_EXP$ = MID$(EXPR$, FOUND_P% + LEN(FOUND_OP$) + 2%, LEN(EXPR$) - FOUND_P% - LEN(FOUND_OP$) - 1%)
  ELSE
    IF FOUND_OP$ = "<>" OR FOUND_OP$ = "<=" OR FOUND_OP$ = ">=" THEN
      LET R_EXP$ = MID$(EXPR$, FOUND_P% + 3%, LEN(EXPR$) - FOUND_P% - 2%)
    ELSE
      IF FOUND_OP$ = "=" OR FOUND_OP$ = "<" OR FOUND_OP$ = ">" THEN
        LET R_EXP$ = MID$(EXPR$, FOUND_P% + 2%, LEN(EXPR$) - FOUND_P% - 1%)
      ELSE
        LET R_EXP$ = MID$(EXPR$, FOUND_P% + 1%, LEN(EXPR$) - FOUND_P%)
      END IF
    END IF
  END IF
  LET ESP% = ESP% + 1%
  LET STK_OP$(ESP%) = FOUND_OP$
  LET STK_REXP$(ESP%) = R_EXP$
  LET EXPR$ = L_EXP$
  GOSUB EVAL_EXPR
  LET EXPR$ = STK_REXP$(ESP%)
  GOSUB EVAL_EXPR
  LET CUR_OP$ = STK_OP$(ESP%)
  LET ESP% = ESP% - 1%
  LET OP_BYTE% = 0%
  IF CUR_OP$ = "+" THEN LET OP_BYTE% = 32%
  IF CUR_OP$ = "-" THEN LET OP_BYTE% = 33%
  IF CUR_OP$ = "*" THEN LET OP_BYTE% = 34%
  IF CUR_OP$ = "/" THEN LET OP_BYTE% = 35%
  IF CUR_OP$ = "=" THEN LET OP_BYTE% = 36%
  IF CUR_OP$ = "<>" THEN LET OP_BYTE% = 37%
  IF CUR_OP$ = "<" THEN LET OP_BYTE% = 38%
  IF CUR_OP$ = ">" THEN LET OP_BYTE% = 39%
  IF CUR_OP$ = "AND" THEN LET OP_BYTE% = 40%
  IF CUR_OP$ = "OR" THEN LET OP_BYTE% = 41%
  IF OP_BYTE% > 0% THEN
    LET BC%(BC_LEN%) = OP_BYTE%
    LET BC_LEN% = BC_LEN% + 1%
  END IF
  IF CUR_OP$ = "<=" THEN
    LET BC%(BC_LEN%) = 39%
    LET BC_LEN% = BC_LEN% + 1%
    LET BC%(BC_LEN%) = 16%
    LET BC_LEN% = BC_LEN% + 1%
    LET BC%(BC_LEN%) = 0%
    LET BC_LEN% = BC_LEN% + 1%
    LET BC%(BC_LEN%) = 0%
    LET BC_LEN% = BC_LEN% + 1%
    LET BC%(BC_LEN%) = 36%
    LET BC_LEN% = BC_LEN% + 1%
  END IF
  IF CUR_OP$ = ">=" THEN
    LET BC%(BC_LEN%) = 38%
    LET BC_LEN% = BC_LEN% + 1%
    LET BC%(BC_LEN%) = 16%
    LET BC_LEN% = BC_LEN% + 1%
    LET BC%(BC_LEN%) = 0%
    LET BC_LEN% = BC_LEN% + 1%
    LET BC%(BC_LEN%) = 0%
    LET BC_LEN% = BC_LEN% + 1%
    LET BC%(BC_LEN%) = 36%
    LET BC_LEN% = BC_LEN% + 1%
  END IF
  RETURN
END IF

! 4. Parentheses
IF LEFT$(EXPR$, 1%) = "(" AND MID$(EXPR$, LEN(EXPR$), 1%) = ")" THEN
  LET MATCH_P% = 0%
  LET IS_ENC% = 1%
  FOR P% = 1% TO LEN(EXPR$) - 1%
    IF MID$(EXPR$, P%, 1%) = "(" THEN LET MATCH_P% = MATCH_P% + 1%
    IF MID$(EXPR$, P%, 1%) = ")" THEN LET MATCH_P% = MATCH_P% - 1%
    IF MATCH_P% = 0% THEN LET IS_ENC% = 0%
  NEXT P%
  IF IS_ENC% = 1% THEN
    LET EXPR$ = MID$(EXPR$, 2%, LEN(EXPR$) - 2%)
    GOTO TRIM_EXPR_LOOP
  END IF
END IF

! 5. Function calls & variable accesses
GOSUB DISPATCH_FUNCTION
RETURN

! Function & Variable Dispatch
DISPATCH_FUNCTION:
IF EXPR$ = "INKEY$" THEN
  LET BC%(BC_LEN%) = 114%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF EXPR$ = "RND" THEN
  LET BC%(BC_LEN%) = 116%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF EXPR$ = "COMMAND$" THEN
  LET BC%(BC_LEN%) = 133%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF EXPR$ = "DATE$" OR EXPR$ = "DATE" OR LEFT$(EXPR$, 6%) = "DATE$(" OR LEFT$(EXPR$, 5%) = "DATE(" THEN
  LET BC%(BC_LEN%) = 16%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 122%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF EXPR$ = "TIME$" OR EXPR$ = "TIME" OR LEFT$(EXPR$, 6%) = "TIME$(" OR LEFT$(EXPR$, 5%) = "TIME(" THEN
  LET BC%(BC_LEN%) = 16%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 0%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = 134%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF LEFT$(EXPR$, 4%) = "LEN(" AND MID$(EXPR$, LEN(EXPR$), 1%) = ")" THEN
  LET EXPR$ = MID$(EXPR$, 5%, LEN(EXPR$) - 5%)
  GOSUB EVAL_EXPR
  LET BC%(BC_LEN%) = 124%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF LEFT$(EXPR$, 4%) = "INT(" AND MID$(EXPR$, LEN(EXPR$), 1%) = ")" THEN
  LET EXPR$ = MID$(EXPR$, 5%, LEN(EXPR$) - 5%)
  GOSUB EVAL_EXPR
  LET BC%(BC_LEN%) = 117%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF LEFT$(EXPR$, 4%) = "VAL(" AND MID$(EXPR$, LEN(EXPR$), 1%) = ")" THEN
  LET EXPR$ = MID$(EXPR$, 5%, LEN(EXPR$) - 5%)
  GOSUB EVAL_EXPR
  LET BC%(BC_LEN%) = 129%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF (LEFT$(EXPR$, 5%) = "STR$(" OR LEFT$(EXPR$, 4%) = "STR(") AND MID$(EXPR$, LEN(EXPR$), 1%) = ")" THEN
  LET P% = INSTR(1%, EXPR$, "(")
  LET EXPR$ = MID$(EXPR$, P% + 1%, LEN(EXPR$) - P% - 1%)
  GOSUB EVAL_EXPR
  LET BC%(BC_LEN%) = 130%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF (LEFT$(EXPR$, 6%) = "ASCII(" OR LEFT$(EXPR$, 4%) = "ASC(") AND MID$(EXPR$, LEN(EXPR$), 1%) = ")" THEN
  LET P% = INSTR(1%, EXPR$, "(")
  LET EXPR$ = MID$(EXPR$, P% + 1%, LEN(EXPR$) - P% - 1%)
  GOSUB EVAL_EXPR
  LET BC%(BC_LEN%) = 131%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF LEFT$(EXPR$, 5%) = "CHR$(" AND MID$(EXPR$, LEN(EXPR$), 1%) = ")" THEN
  LET EXPR$ = MID$(EXPR$, 6%, LEN(EXPR$) - 6%)
  GOSUB EVAL_EXPR
  LET BC%(BC_LEN%) = 115%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF LEFT$(EXPR$, 4%) = "SYS(" AND MID$(EXPR$, LEN(EXPR$), 1%) = ")" THEN
  LET EXPR$ = MID$(EXPR$, 5%, LEN(EXPR$) - 5%)
  GOSUB EVAL_EXPR
  LET BC%(BC_LEN%) = 132%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF LEFT$(EXPR$, 6%) = "LEFT$(" AND MID$(EXPR$, LEN(EXPR$), 1%) = ")" THEN
  LET ARGS$ = MID$(EXPR$, 7%, LEN(EXPR$) - 7%)
  LET CP% = INSTR(1%, ARGS$, ",")
  LET EXPR$ = LEFT$(ARGS$, CP% - 1%)
  GOSUB EVAL_EXPR
  LET EXPR$ = MID$(ARGS$, CP% + 1%, LEN(ARGS$) - CP%)
  GOSUB EVAL_EXPR
  LET BC%(BC_LEN%) = 126%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF LEFT$(EXPR$, 7%) = "RIGHT$(" AND MID$(EXPR$, LEN(EXPR$), 1%) = ")" THEN
  LET ARGS$ = MID$(EXPR$, 8%, LEN(EXPR$) - 8%)
  LET CP% = INSTR(1%, ARGS$, ",")
  LET EXPR$ = LEFT$(ARGS$, CP% - 1%)
  GOSUB EVAL_EXPR
  LET EXPR$ = MID$(ARGS$, CP% + 1%, LEN(ARGS$) - CP%)
  GOSUB EVAL_EXPR
  LET BC%(BC_LEN%) = 127%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF LEFT$(EXPR$, 5%) = "MID$(" AND MID$(EXPR$, LEN(EXPR$), 1%) = ")" THEN
  LET ARGS$ = MID$(EXPR$, 6%, LEN(EXPR$) - 6%)
  LET CP1% = INSTR(1%, ARGS$, ",")
  LET CP2% = INSTR(CP1% + 1%, ARGS$, ",")
  LET EXPR$ = LEFT$(ARGS$, CP1% - 1%)
  GOSUB EVAL_EXPR
  LET EXPR$ = MID$(ARGS$, CP1% + 1%, CP2% - CP1% - 1%)
  GOSUB EVAL_EXPR
  LET EXPR$ = MID$(ARGS$, CP2% + 1%, LEN(ARGS$) - CP2%)
  GOSUB EVAL_EXPR
  LET BC%(BC_LEN%) = 125%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF LEFT$(EXPR$, 6%) = "INSTR(" AND MID$(EXPR$, LEN(EXPR$), 1%) = ")" THEN
  LET ARGS$ = MID$(EXPR$, 7%, LEN(EXPR$) - 7%)
  LET CP1% = INSTR(1%, ARGS$, ",")
  LET CP2% = INSTR(CP1% + 1%, ARGS$, ",")
  IF CP2% > 0% THEN
    LET EXPR$ = LEFT$(ARGS$, CP1% - 1%)
    GOSUB EVAL_EXPR
    LET EXPR$ = MID$(ARGS$, CP1% + 1%, CP2% - CP1% - 1%)
    GOSUB EVAL_EXPR
    LET EXPR$ = MID$(ARGS$, CP2% + 1%, LEN(ARGS$) - CP2%)
    GOSUB EVAL_EXPR
  ELSE
    LET BC%(BC_LEN%) = 16%
    LET BC_LEN% = BC_LEN% + 1%
    LET BC%(BC_LEN%) = 1%
    LET BC_LEN% = BC_LEN% + 1%
    LET BC%(BC_LEN%) = 0%
    LET BC_LEN% = BC_LEN% + 1%
    LET EXPR$ = LEFT$(ARGS$, CP1% - 1%)
    GOSUB EVAL_EXPR
    LET EXPR$ = MID$(ARGS$, CP1% + 1%, LEN(ARGS$) - CP1%)
    GOSUB EVAL_EXPR
  END IF
  LET BC%(BC_LEN%) = 128%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
IF INSTR(1%, EXPR$, "(") > 0% AND MID$(EXPR$, LEN(EXPR$), 1%) = ")" THEN
  LET P1% = INSTR(1%, EXPR$, "(")
  LET VNAME$ = LEFT$(EXPR$, P1% - 1%)
  GOSUB LOOKUP_VAR
  LET V_IDX% = VAR_IDX%
  LET EXPR$ = MID$(EXPR$, P1% + 1%, LEN(EXPR$) - P1% - 1%)
  GOSUB EVAL_EXPR
  LET BC%(BC_LEN%) = 23%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = V_IDX% AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  LET BC%(BC_LEN%) = INT(V_IDX% / 256%) AND 255%
  LET BC_LEN% = BC_LEN% + 1%
  RETURN
END IF
LET VNAME$ = EXPR$
GOSUB LOOKUP_VAR
LET BC%(BC_LEN%) = 20%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = VAR_IDX% AND 255%
LET BC_LEN% = BC_LEN% + 1%
LET BC%(BC_LEN%) = INT(VAR_IDX% / 256%) AND 255%
LET BC_LEN% = BC_LEN% + 1%
RETURN

! Relocation Resolver Pass
RESOLVE_RELOCS:
FOR R% = 1% TO NUM_RELS%
  LET RTYPE$ = REL_TYPE$(R%)
  IF RTYPE$ = "JMP" OR RTYPE$ = "JMP_Z" OR RTYPE$ = "ON_ERROR" OR RTYPE$ = "RESUME" THEN
    LET T_FOUND% = 0%
    LET T_OFF% = 0%
    FOR L% = 1% TO NUM_LINES%
      IF REL_TGT_NUM%(R%) > 0% AND LINE_NUM%(L%) = REL_TGT_NUM%(R%) THEN
        LET T_FOUND% = 1%
        LET T_OFF% = LINE_OFF%(L%)
      END IF
      IF REL_TGT_NAME$(R%) <> "" AND LINE_LBL$(L%) = REL_TGT_NAME$(R%) THEN
        LET T_FOUND% = 1%
        LET T_OFF% = LINE_OFF%(L%)
      END IF
    NEXT L%
    IF T_FOUND% THEN
      LET ROFF% = REL_OFF%(R%)
      LET BC%(ROFF%) = T_OFF% AND 255%
      LET BC%(ROFF% + 1%) = INT(T_OFF% / 256%) AND 255%
    END IF
  END IF
NEXT R%
RETURN

! Output Writer: Emit .obj (JSON) and .bin (raw bytecode)
WRITE_OUTPUT:
OPEN OUT_BOBJ$ FOR OUTPUT AS FILE #2%
PRINT #2%, "{"
PRINT #2%, "  " + Q$ + "version" + Q$ + ": 1,"
PRINT #2%, "  " + Q$ + "module" + Q$ + ": " + Q$ + MOD_NAME$ + Q$ + ","
PRINT #2%, "  " + Q$ + "symbols" + Q$ + ": ["
PRINT #2%, "    {"
PRINT #2%, "      " + Q$ + "name" + Q$ + ": " + Q$ + MOD_NAME$ + "_START" + Q$ + ","
PRINT #2%, "      " + Q$ + "type" + Q$ + ": " + Q$ + "EXPORT" + Q$ + ","
PRINT #2%, "      " + Q$ + "offset" + Q$ + ": 0"
PRINT #2%, "    }"
PRINT #2%, "  ],"
PRINT #2%, "  " + Q$ + "relocations" + Q$ + ": ["
FOR R% = 1% TO NUM_RELS%
  PRINT #2%, "    {"
  PRINT #2%, "      " + Q$ + "offset" + Q$ + ": "; REL_OFF%(R%); ","
  PRINT #2%, "      " + Q$ + "type" + Q$ + ": " + Q$ + REL_TYPE$(R%) + Q$;
  IF REL_TYPE$(R%) = "CALL_OVL" THEN
    PRINT #2%, ","
    PRINT #2%, "      " + Q$ + "target" + Q$ + ": " + Q$ + REL_TGT_NAME$(R%) + Q$
  ELSE
    IF REL_TGT_NUM%(R%) > 0% THEN
      PRINT #2%, ","
      PRINT #2%, "      " + Q$ + "target_line" + Q$ + ": "; REL_TGT_NUM%(R%)
    ELSE
      PRINT #2%, ","
      PRINT #2%, "      " + Q$ + "target_line" + Q$ + ": " + Q$ + REL_TGT_NAME$(R%) + Q$
    END IF
  END IF
  IF R% < NUM_RELS% THEN
    PRINT #2%, "    },"
  ELSE
    PRINT #2%, "    }"
  END IF
NEXT R%
PRINT #2%, "  ],"
PRINT #2%, "  " + Q$ + "strings" + Q$ + ": [],"
PRINT #2%, "  " + Q$ + "bytecode" + Q$ + ": ["
FOR B% = 0% TO BC_LEN% - 1%
  IF B% < BC_LEN% - 1% THEN
    PRINT #2%, "    "; BC%(B%); ","
  ELSE
    PRINT #2%, "    "; BC%(B%)
  END IF
NEXT B%
PRINT #2%, "  ]"
PRINT #2%, "}"
CLOSE #2%

! Emit .bin via hex output
LET TMP_HEX$ = OUT_BIN$ + ".hex"
OPEN TMP_HEX$ FOR OUTPUT AS FILE #2%
FOR B% = 0% TO BC_LEN% - 1%
  LET BYT% = BC%(B%)
  PRINT #2%, MID$(HEX_CHARS$, INT(BYT% / 16%) + 1%, 1%) + MID$(HEX_CHARS$, (BYT% AND 15%) + 1%, 1%);
NEXT B%
CLOSE #2%
LET CMD$ = "xxd -r -p " + TMP_HEX$ + " > " + OUT_BIN$ + " 2>/dev/null || python3 -c " + Q$ + "import sys; open('" + OUT_BIN$ + "', 'wb').write(bytes.fromhex(open('" + TMP_HEX$ + "').read()))" + Q$
LET RC% = SYS(CMD$)
LET RC% = SYS("rm -f " + TMP_HEX$)
PRINT "Compiled "; IN_FILE$; " to "; OUT_BOBJ$; " and "; OUT_BIN$
RETURN
