760 LET VERB$ = LEFT$(W_CMD$, SP_P% - 1%)
765 LET ARGS$ = MID$(W_CMD$, SP_P% + 1%, LEN(W_CMD$) - SP_P%)
770 GOTO 785
775 LET VERB$ = W_CMD$
780 LET ARGS$ = ""
785 LET U_IN$ = VERB$
790 GOSUB 2500
795 LET VERB$ = U_OUT$
800 LET T_IN$ = ARGS$
805 GOSUB 2400
810 LET ARGS$ = T_OUT$
815 IF VERB$ = "EXIT" OR VERB$ = "QUIT" OR VERB$ = "BYE" THEN GOTO 2900
820 IF VERB$ = "HELP" OR VERB$ = "?" THEN GOTO 900
825 IF VERB$ = "SAMPLE" OR VERB$ = "DEMO" THEN GOTO 1000
830 IF VERB$ = "LIST" OR VERB$ = "SOURCE" THEN GOTO 1150
835 IF VERB$ = "SYMBOLS" OR VERB$ = "SYM" OR VERB$ = "CHECK" THEN GOTO 1250
840 IF VERB$ = "ASSEMBLE" OR VERB$ = "COMPILE" OR VERB$ = "BUILD" THEN GOTO 1500
845 IF VERB$ = "LOAD" THEN GOTO 1600
850 IF VERB$ = "SAVE" THEN GOTO 1700
880 PRINT "?MACRO-W-IVCMD, unrecognized command: "; VERB$
