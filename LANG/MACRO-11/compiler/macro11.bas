680 LET SC_REM$ = MID$(SC_REM$, SC_P% + 1%, LEN(SC_REM$) - SC_P%)
685 GOTO 700
690 LET ONE_CMD$ = SC_REM$
695 LET SC_REM$ = ""
700 GOSUB 730
705 GOTO 660
710 IF IS_INTERACTIVE% = 0% THEN GOTO 2900
715 GOTO 630
730 LET T_IN$ = ONE_CMD$
735 GOSUB 2400
740 LET W_CMD$ = T_OUT$
